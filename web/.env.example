# Τοπική ανάπτυξη. Μην βάζεις εδώ πραγματικά κλειδιά παραγωγής.
DATABASE_URL="postgresql://postgres@localhost:5433/gelato?schema=public"

# Viva (ISV). Κενά = το ταμείο δουλεύει σε «δοκιμαστική λειτουργία» και ΔΕΝ διαβιβάζει τίποτα.
VIVA_ENV="demo"
VIVA_ISV_CLIENT_ID=""
VIVA_ISV_CLIENT_SECRET=""

# Πρώτος διαχειριστής πλατφόρμας (δημιουργείται με: npx prisma db seed)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# 1 = ο server είναι προσβάσιμος ΜΟΝΟ μέσα από proxy που γράφει το x-forwarded-for (π.χ. tailscale serve).
# Τότε ισχύει ο έλεγχος «διεύθυνση Tailscale» των συσκευών.
TRUST_PROXY=""

# Mailgun: ένα επαληθευμένο domain για όλη την πλατφόρμα
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_REGION="eu"

# Η δημόσια διεύθυνση της εφαρμογής (για συνδέσμους στα email όταν ο πελάτης δεν έχει υποτομέα)
APP_URL="http://localhost:3210"

# Μυστικό για το /api/cron/subscriptions (20+ χαρακτήρες)
CRON_SECRET=""

# Viva της ΠΛΑΤΦΟΡΜΑΣ: ο λογαριασμός όπου πληρώνονται οι συνδρομές (Smart Checkout credentials).
# Στην πηγή πληρωμών της Viva όρισε Success URL: <διεύθυνση εφαρμογής>/billing/paid
VIVA_PLATFORM_CLIENT_ID=""
VIVA_PLATFORM_CLIENT_SECRET=""
VIVA_PLATFORM_SOURCE_CODE=""
