# Μόνο ό,τι χρειάζεται για να ξεκινήσει ο server. Όλα τα άλλα (Viva, Mailgun, Bunny, διεύθυνση εφαρμογής,
# μυστικό προγραμματισμένων εργασιών) ορίζονται από την οθόνη: Πλατφόρμα › Ρυθμίσεις & email.

DATABASE_URL="postgresql://postgres@localhost:5433/gelato?schema=public"

# Πρώτος διαχειριστής πλατφόρμας (δημιουργείται με: npx prisma db seed). Μετά τη δημιουργία μπορούν να σβηστούν.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# 1 = ο server είναι προσβάσιμος ΜΟΝΟ μέσα από proxy που γράφει το x-forwarded-for (π.χ. tailscale serve).
# Τότε ισχύει ο έλεγχος «διεύθυνση Tailscale» των συσκευών και καταγράφεται η διεύθυνση στις συναινέσεις.
TRUST_PROXY=""
