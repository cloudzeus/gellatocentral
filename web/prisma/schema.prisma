  note          String?
  clientKey     String? // Nullable ώστε οι ιστορικές πληρωμές να μην χρειάζονται backfill.
  requestHash   String?
  createdByName String
  createdAt     DateTime                    @default(now())
  org           Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  allocations   SupplierPaymentAllocation[]

  @@unique([orgId, clientKey])
  @@index([orgId, supplierId, paidAt])
}

model SupplierPaymentAllocation {
  id            String          @id @default(cuid())
  orgId         String
  paymentId     String
  purchaseDocId String
  amountCents   Int
  createdAt     DateTime        @default(now())
  payment       SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, purchaseDocId])
  @@index([orgId, purchaseDocId])
}

model CashClosing {
