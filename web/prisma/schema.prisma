// Gelato System SaaS — πυρήνας πολυ-επιχειρησιακός + συνδρομή + ταμείο + ηλεκτρονική τιμολόγηση (Viva).
// Κάθε πίνακας δεδομένων επιχείρησης έχει orgId. Ποσά πάντα σε λεπτά (Int).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  SUPER_ADMIN
  MANAGER
  STAFF // υπάλληλος της εφαρμογής
  SUPPORT // υπάλληλος υποστήριξης
}

enum DeviceKind {
  POS_WEB // ταμείο σε browser — πληρωμή μέσω Viva Cloud Terminal API
  POS_ANDROID // εφαρμογή Android — πληρωμή μέσω Viva inter-app
  KITCHEN_DISPLAY // οθόνη κουζίνας/εργαστηρίου: δείχνει παραγγελίες, δεν εκδίδει παραστατικά και δεν χρεώνεται
  FRIDGE // ψυγείο/καταψύκτης/βιτρίνα: είναι και αποθηκευτικός χώρος, στέλνει θερμοκρασίες
  VENDING_MACHINE // αυτόματος πωλητής: είναι και αποθηκευτικός χώρος, στέλνει θερμοκρασίες
  SCALE // ζυγαριά, δεμένη με ταμείο ή με το εργαστήριο (κατάστημα)
}

// Σταθμός παρασκευής: κάθε κατηγορία πάει σε έναν και κάθε οθόνη κουζίνας δείχνει έναν (ή όλους).
enum KitchenStation {
  KITCHEN
  BAR
}

// Τι είδους σημείο είναι το κατάστημα: ορίζει το πρότυπο του οδηγού στησίματος και τι δείχνουν οι οθόνες.
// Κενό σε παλιά καταστήματα (πριν τον οδηγό).
enum StoreKind {
  SHOP_TABLES // κατάστημα με ταμείο, ψυγεία, τραπέζια και κρατήσεις
  WORKSHOP // εργαστήριο: παραγωγή, χονδρική, τροφοδοτεί τα άλλα σημεία
  VENDING // μόνο αυτόματος πωλητής, γεμίζει από άλλο σημείο
  VENDING_STOCK // αυτόματος πωλητής με δικά του αποθέματα
}

enum PrinterRole {
  RECEIPTS // αποδείξεις, δίπλα στο ταμείο
  ORDERS // παραγγελίες τραπεζιών, στον πάγκο
}

enum PrinterConnection {
  NETWORK // IP:θύρα (Ethernet / Wi-Fi)
  BLUETOOTH // διεύθυνση MAC
  USB
}

enum SaleStatus {
  DRAFT
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

// Πώς εκτελείται μια πληρωμή: στο τερματικό Viva, στο Smart Checkout της Viva, ή εκτός συστήματος (χειροκίνητα)
enum PaymentProvider {
  VIVA_TERMINAL
  VIVA_CHECKOUT
  MANUAL
}

// Λογιστική κατηγορία του ποσού (πρότυπο SoftOne): ταμείο, διακανονισμός καρτών, τράπεζα ή απαίτηση
enum PaymentLedger {
  CASH
  CARD_CLEARING
  BANK
  CREDIT
}

enum FiscalStatus {
  NOT_SENT // δοκιμαστική λειτουργία: δεν διαβιβάστηκε
  PENDING // στάλθηκε στη Viva, περιμένουμε αποτέλεσμα
  SIGNED // η Viva υπέγραψε και διαβίβασε στο myDATA
  FAILED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum StockCountStatus {
  DRAFT
  FINALIZED
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

enum ProductionPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum WholesaleOrderStatus {
  DRAFT
  CONFIRMED
  DELIVERED
  INVOICED
  CANCELLED
}

enum WholesaleQuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum SalesDocumentStatus {
  ISSUED
  CANCELLED
}

enum CashClosingStatus {
  CLOSED
  REOPENED
}

enum StockHoldStatus {
  AVAILABLE
  HELD
  RELEASED
  REJECTED
}

enum MigrationRunStatus {
  DRY_RUN
  IMPORTED
  ROLLED_BACK
}

enum MigrationRunKind {
  BASELINE
  DELTA
}

enum MigrationCutoverStatus {
  PREPARING
  FROZEN
  DELTA_IMPORTED
  READY
  ACTIVE
  ROLLED_BACK
}

model Organization {
  id              String     @id @default(cuid())
  name            String
  vatNumber       String     @unique // ΑΦΜ
  // Viva: merchant κάτω από τον ISV λογαριασμό μας (isvDetails.terminalMerchantId)
  vivaMerchantId  String?
  // Κλειδίδια myDATA (ΑΑΔΕ) για λήψη εισερχόμενων τιμολογίων (RequestMyIncome) — τα ορίζει η πλατφόρμα
  aadeUserId      String?
  aadeSubKey      String?
  // Υποτομέας του πελάτη: <slug>.<baseDomain> για την εφαρμογή και <slug>@<mail domain> ως αποστολέας
  slug            String?    @unique
  contactEmail    String? // εδώ απαντούν οι παραλήπτες (Reply-To) και εδώ πάνε οι ειδοποιήσεις συνδρομής
  emailFromName   String? // όνομα αποστολέα· κενό = η επωνυμία
  // Αναστολή από την πλατφόρμα και κλείσιμο επιχείρησης (lib/org-state.ts)
  suspendedAt     DateTime?
  suspendedReason String?
  closingAt       DateTime? // ξεκίνησε το κλείσιμο: περιορισμένη λειτουργία και εξαγωγή δεδομένων
  deleteAfter     DateTime? // από αυτή την ημέρα επιτρέπεται η οριστική διαγραφή
  createdAt       DateTime   @default(now())
  emails          EmailLog[]

  stores               Store[]
  warehouses           Warehouse[]
  warehouseMemberships MembershipWarehouse[]
  auditEvents          AuditEvent[]
  printers             Printer[]
  members              Membership[]
  roles                OrgRole[]
  groups               OrgGroup[]
  staffAccesses        StaffStoreAccess[]
  categories           Category[]
  modifierGroups       ModifierGroup[]
  products             Product[]
  sales                Sale[]
  diningTables         DiningTable[]
  bills                Bill[]
  reservations         Reservation[]
  offPremiseOrders     Order[]
  calls                Call[]
  integrations         Integration[]
  subscription         Subscription?
  files                StoredFile[]
  parties              Party[]               @relation("OrgParties")
  persons              Person[]
  asParty              Party?                @relation("OrgAsParty")
  tradeItems           TradeItem[] // «ιδιωτικά» εμπορικά είδη της επιχείρησης (δεν υπάρχουν στον κεντρικό κατάλογο)
  genericItems         GenericItem[]
  itemMappings         ItemMapping[]
  supplierItems        SupplierItem[]
  purchaseDocs         PurchaseDoc[]
  mydataChecks         MydataCheck[]
  mydataIncoming       MydataIncoming[]
  stockLots            StockLot[]
  stockTransfers       StockTransfer[]
  stockCounts          StockCount[]
  stockCountEdits      StockCountEdit[]
  stockThresholds      StockThreshold[]
  usageEvents          UsageEvent[]
  tickets              Ticket[]
  documentSeries       DocumentSeries[]
  fiscalDocuments      FiscalDocument[]
  fiscalAttempts       FiscalAttempt[]
  legalEntities        LegalEntity[]
  compositions         Composition[]
  recipes              Recipe[]
  recipeItems          RecipeItem[]
  productionBatches    ProductionBatch[]
  productionBatchItems ProductionBatchItem[]
  haccpRecords         HaccpRecord[]
  haccpAssessments     HaccpAssessment[]

  legalName              String?
  taxOffice              String?
  address                String?
  city                   String?
  postalCode             String?
  phone                  String?
  logoUrl                String?
  labelExtraText         String?
  mrpUsageDays           Int                       @default(28)
  mrpCoverDays           Int                       @default(4)
  mrpSporadicDays        Int                       @default(4)
  externalSendingEnabled Boolean                   @default(false)
  purchaseOrders         PurchaseOrder[]
  purchaseReceipts       PurchaseReceipt[]
  mrpSettings            MrpItemSetting[]
  rfqs                   Rfq[]
  documentDeliveries     DocumentDelivery[]
  machines               Machine[]
  recipeVersions         RecipeVersion[]
  productionPlans        ProductionPlan[]
  productionDayCloses    ProductionDayClose[]
  productionCorrections  ProductionCorrection[]
  haccpLotChecks         HaccpLotCheck[]
  priceLists             PriceList[]
  wholesaleQuotes        WholesaleQuote[]
  wholesaleOrders        WholesaleOrder[]
  deliveryRoutes         DeliveryRoute[]
  salesDocuments         SalesDocument[]
  customerPayments       CustomerPayment[]
  b2bAccesses            B2bAccess[]
  departments            Department[]
  employees              Employee[]
  employeePays           EmployeePay[]
  shifts                 Shift[]
  schedulePublications   SchedulePublication[]
  employeeLeaves         EmployeeLeave[]
  scheduleLinks          ScheduleLink[]
  financeAccounts        FinanceAccount[]
  financeTransactions    FinanceTransaction[]
  statementImports       FinanceStatementImport[]
  payrollPaymentBatches  PayrollPaymentBatch[]
  payrollExecutions      PayrollPaymentExecution[]
  expenses               Expense[]
  supplierPayments       SupplierPayment[]
  cashClosings           CashClosing[]
  budgetTargets          BudgetTarget[]
  vitrineSettings        VitrineSetting[]
  vitrineViews           VitrineDailyView[]
  migrationRuns          MigrationRun[]
  taskRuns               TaskRun[]
  migrationCutover       MigrationCutover?
  mydataDayChecks        MydataDayCheck[]
}

model User {
  id               String                @id @default(cuid())
  email            String                @unique
  name             String
  passwordHash     String?
  // Προσωπικό της πλατφόρμας: βλέπει την κονσόλα συνδρομητών, δεν ανήκει σε επιχείρηση. Κενό = χρήστης συνδρομητή.
  platformRole     PlatformRole?
  failedLogins     Int                   @default(0)
  lockedUntil      DateTime?
  // Δικός σας ρόλος προσωπικού (φτιαγμένος από την οθόνη). Όταν υπάρχει, τα δικαιώματα έρχονται από αυτόν και το platformRole μένει STAFF.
  staffRoleId      String?
  staffRole        StaffRole?            @relation(fields: [staffRoleId], references: [id], onDelete: Restrict)
  disabledAt       DateTime? // απενεργοποιημένος: δεν συνδέεται, αλλά μένει στο ιστορικό
  lastLoginAt      DateTime?
  createdAt        DateTime              @default(now())
  memberships      Membership[]
  auditEvents      AuditEvent[]
  stockMovements   StockMovement[]
  stockTransfers   StockTransfer[]
  countsCreated    StockCount[]          @relation("CountCreatedBy")
  countsFinalized  StockCount[]          @relation("CountFinalizedBy")
  sessions         Session[]             @relation("SessionUser")
  impersonations   Session[]             @relation("SessionImpersonator")
  resets           PasswordReset[]
  staffGroups      StaffGroupMember[]
  storeAccesses    StaffStoreAccess[]
  tablePreferences UserTablePreference[]
}

// Προσωπική διάταξη κάθε DataTable: ακολουθεί τον χρήστη σε όλες τις συσκευές.
model UserTablePreference {
  userId    String
  tableId   String
  prefs     Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, tableId])
}

// Σύνδεσμος ορισμού κωδικού: για «ξέχασα τον κωδικό» (1 ώρα) και για πρόσκληση νέου χρήστη (72 ώρες).
model PasswordReset {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED // δεν έχει οριστεί Mailgun: το email μόνο καταγράφηκε
}

model EmailLog {
  id        String        @id @default(cuid())
  orgId     String?
  to        String
  template  String
  subject   String
  status    EmailStatus
  error     String?
  // Μοναδικό κλειδί για email που πρέπει να φύγουν ΜΙΑ φορά (π.χ. υπενθύμιση λήξης μιας περιόδου)
  dedupeKey String?       @unique
  createdAt DateTime      @default(now())
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([orgId, createdAt])
}

// Μία γραμμή (id = 1) με τα στοιχεία της πλατφόρμας. Οι ρυθμίσεις σύνδεσης (Viva, Mailgun, Bunny) ζουν στον πίνακα Setting.
model PlatformSettings {
  id                 Int       @id @default(1)
  brandName          String    @default("Gelato System")
  baseDomain         String? // π.χ. gelatosystem.app → aurora.gelatosystem.app
  supportEmail       String?
  // Συνέχεια λειτουργίας: πότε επιβεβαιώθηκε τελευταία φορά ότι τα αντίγραφα υπάρχουν και ότι η επαναφορά δουλεύει
  lastBackupCheckAt  DateTime?
  lastRestoreDrillAt DateTime?
  // Νομικά κείμενα που αποδέχεται κάθε χρήστης. Και τα τρία μαζί ενεργοποιούν την υποχρεωτική αποδοχή· νέα έκδοση = νέα αποδοχή.
  legalVersion       String? // π.χ. "2026-11"
  termsUrl           String?
  privacyUrl         String?
}

model Session {
  id             String   @id @default(cuid())
  tokenHash      String   @unique // sha256 του cookie· το ίδιο το token δεν αποθηκεύεται
  userId         String
  // Προσωρινή πρόσβαση υποστήριξης: το userId είναι του tenant, εδώ μένει ο πραγματικός admin.
  impersonatorId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  userAgent      String? // για τη λίστα «Συνδέσεις» του χρήστη
  user           User     @relation("SessionUser", fields: [userId], references: [id], onDelete: Cascade)
  impersonator   User?    @relation("SessionImpersonator", fields: [impersonatorId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([impersonatorId])
}

model Membership {
  id         String                @id @default(cuid())
  orgId      String
  userId     String
  roleId     String
  org        Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       OrgRole               @relation(fields: [roleId], references: [id])
  // Πολλαπλά καταστήματα και ομάδες· τα δικαιώματα του μέλους είναι η ΕΝΩΣΗ ρόλου + ομάδων
  stores     MembershipStore[]
  warehouses MembershipWarehouse[]
  groups     MembershipGroup[]

  @@unique([orgId, userId])
  @@index([userId]) // οι επιχειρήσεις ενός χρήστη
}

// Ομάδα χρηστών μιας επιχείρησης: όνομα + δικαιώματα (κλειδιά area.action από lib/permissions.ts).
// Προσθετική μόνο: ό,τι δίνει η ομάδα προστίθεται στον ρόλο· δεν υπάρχει αφαίρεση.
model OrgGroup {
  id          String            @id @default(cuid())
  orgId       String
  name        String
  permissions String[]
  createdAt   DateTime          @default(now())
  org         Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     MembershipGroup[]

  @@unique([orgId, name])
}

// Σε ποια καταστήματα δουλεύει το μέλος. Καμία γραμμή = όλα τα καταστήματα της επιχείρησης.
model MembershipStore {
  membershipId String
  storeId      String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([membershipId, storeId])
}

// Ρητή πρόσβαση σε αποθήκη. Κενό = όλες εντός του store scope· ρητή γραμμή επιτρέπει και standalone εργαστήριο.
model MembershipWarehouse {
  orgId        String
  membershipId String
  warehouseId  String
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([membershipId, warehouseId])
  @@index([orgId, warehouseId])
  @@index([warehouseId])
}

model MembershipGroup {
  membershipId String
  groupId      String
  membership   Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  group        OrgGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([membershipId, groupId])
}

// Ρόλος μιας επιχείρησης: όνομα + λίστα δικαιωμάτων (κλειδιά από lib/permissions.ts).
model OrgRole {
  id          String       @id @default(cuid())
  orgId       String
  name        String
  permissions String[]
  system      Boolean      @default(false) // δημιουργήθηκε αυτόματα με την επιχείρηση
  locked      Boolean      @default(false) // «Ιδιοκτήτης»: δεν αλλάζει και δεν διαγράφεται
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members     Membership[]

  @@unique([orgId, name])
}

// Υποκατάστημα με δικό του ΑΦΜ (άλλη εταιρεία του ίδιου ομίλου, συνήθως σε άλλη πόλη): εκδίδει με τα δικά του στοιχεία,
// με δικά του κλειδιά myDATA και δικό του έμπορο Viva. Τα βιβλία και τα υπόλοιπα πελατών χωρίζουν ανά ΑΦΜ.
model LegalEntity {
  id             String       @id @default(cuid())
  orgId          String
  name           String // επωνυμία όπως στο Taxisnet
  vatNumber      String // ΑΦΜ
  taxOffice      String? // ΔΟΥ
  address        String?
  city           String?
  postalCode     String?
  phone          String?
  vivaMerchantId String? // έμπορος Viva του ΑΦΜ (κάτω από τον ISV)
  aadeUserId     String?
  aadeSubKey     String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stores         Store[]

  @@unique([orgId, vatNumber])
}

model Store {
  id               String             @id @default(cuid())
  orgId            String
  name             String
  address          String?
  kind             StoreKind?
  // Viva: «πηγή πληρωμών» του καταστήματος, αν ο έμπορος έχει περισσότερα από ένα
  vivaSourceCode   String?
  // Γεωγραφικά του καταστήματος: για χάρτη, αποστάσεις από πελάτες και αναφορές ανά περιοχή
  city             String?
  postalCode       String?
  region           String?
  latitude         Float?
  longitude        Float?
  // Σύνδεση με τη γεωγραφία αναφοράς (Geo*): το πιο αναλυτικό επίπεδο Καλλικράτη που ταιριάζει (συνήθως ο Δήμος),
  // η πόλη και η περιοχή. Τα πεδία-κείμενο παραπάνω μένουν ως «φωτογραφία» για εκτυπώσεις και αναζήτηση.
  regionCode       String?
  geoRegion        GeoRegion?         @relation(fields: [regionCode], references: [code], onDelete: SetNull)
  cityId           String?
  geoCity          GeoCity?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  areaId           String?
  geoArea          GeoArea?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  geocodedAt       DateTime? // πότε βρέθηκαν οι συντεταγμένες από την υπηρεσία χάρτη
  // Εκδότης των παραστατικών του καταστήματος: κενό = η ίδια η επιχείρηση (Organization.vatNumber)
  legalEntityId    String?
  legalEntity      LegalEntity?       @relation(fields: [legalEntityId], references: [id], onDelete: Restrict)
  // Δικά του κλειδιά myDATA (ένας ΑΦΜ μπορεί να έχει χρήστη ανά κατάστημα). Κενά = του εκδότη (LegalEntity ή επιχείρηση).
  aadeUserId       String?
  aadeSubKey       String?
  active           Boolean            @default(true)
  org              Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  devices          Device[]
  warehouses       StoreWarehouse[] // ποιες αποθήκες εξυπηρετούν το κατάστημα και ποια είναι η προεπιλογή του
  printers         Printer[]
  sales            Sale[]
  diningTables     DiningTable[]
  soldOut          SoldOut[]
  bills            Bill[]
  reservations     Reservation[]
  offPremiseOrders Order[]
  membershipStores MembershipStore[]
  staffAccesses    StaffStoreAccess[]
  pauses           StorePause[]
  documentSeries   DocumentSeries[]
  stockTransfers   StockTransfer[]
  stockCounts      StockCount[]
  haccpRecords     HaccpRecord[]
  staff            EmployeeStore[]

  @@index([orgId])
}

// Συσκευή τιμολόγησης = μονάδα χρέωσης της συνδρομής. Κάθε συσκευή έχει δική της σειρά παραστατικών,
// ώστε η αρίθμηση (ΑΑ) να μην έχει ποτέ κενά ή συγκρούσεις μεταξύ ταμείων.
model Device {
  id                 String          @id @default(cuid())
  orgId              String
  storeId            String
  name               String
  kind               DeviceKind
  series             String? // σειρά παραστατικών, π.χ. "A1"· κενή για συσκευές που δεν τιμολογούν
  nextAa             Int             @default(1)
  vivaTerminalId     String? // το terminalId του τερματικού Viva που αντιστοιχεί στο ταμείο
  vivaCloud          Boolean         @default(false) // ταμείο Android που πληρώνει σε ΑΛΛΗ συσκευή (π.χ. SoftPOS σε τηλέφωνο) μέσω Cloud Terminal, όχι inter-app
  apiTokenHash       String?         @unique // sha256 του κλειδιού της εφαρμογής Android (εκδίδεται στη σύζευξη)
  // Σύζευξη: κωδικός μίας χρήσης που δίνει η κονσόλα και πληκτρολογείται στη συσκευή
  pairCode           String?         @unique
  pairCodeExpiresAt  DateTime?
  pairedAt           DateTime?
  lastSeenAt         DateTime?
  // Ταυτότητα υλικού: MAC της συσκευής (καταγραφή) και διεύθυνση Tailscale (100.x.y.z).
  // Όταν υπάρχει tailscaleIp, η συσκευή γίνεται δεκτή ΜΟΝΟ από αυτή τη διεύθυνση.
  macAddress         String?
  androidId          String? // Settings.Secure.ANDROID_ID: σταθερό ανά συσκευή (η MAC δεν διαβάζεται από Android 10+)
  tailscaleIp        String?
  pbxExtension       String? // εσωτερικό του τηλεφωνικού κέντρου: η κλήση σε αυτό ανοίγει την καρτέλα του πελάτη σε αυτό το ταμείο
  remoteId           String? // αριθμός RustDesk της συσκευής, για απομακρυσμένη υποστήριξη
  remoteAccesses     RemoteAccess[]
  // Ψυγείο / αυτόματος πωλητής: ο αποθηκευτικός χώρος που αντιστοιχεί στη συσκευή και τα όρια θερμοκρασίας (°C)
  warehouseId        String?         @unique
  tempMin            Float?
  tempMax            Float?
  // Προεπιλεγμένη αποθήκη του ταμείου (η «σειρά παραστατικών» της εφαρμογής): υπερισχύει της προεπιλογής
  // του καταστήματος όταν η πώληση δεν δίνει ρητά αποθήκη. Πρέπει να επιτρέπεται στο κατάστημα (StoreWarehouse).
  defaultWarehouseId String?
  // Ζυγαριά: το ταμείο που εξυπηρετεί· κενό = ζυγαριά του εργαστηρίου/καταστήματος
  linkedDeviceId     String?
  warehouse          Warehouse?      @relation("DeviceWarehouse", fields: [warehouseId], references: [id], onDelete: SetNull)
  defaultWarehouse   Warehouse?      @relation("DeviceDefaultWarehouse", fields: [defaultWarehouseId], references: [id], onDelete: SetNull)
  linkedDevice       Device?         @relation("DeviceLink", fields: [linkedDeviceId], references: [id], onDelete: SetNull)
  peripherals        Device[]        @relation("DeviceLink")
  readings           Reading[]
  printerId          String? // ο εκτυπωτής που τυπώνει τις αποδείξεις αυτού του ταμείου
  // Οθόνη κουζίνας: ποιον σταθμό δείχνει (κενό = όλους) και μετά από πόσα λεπτά ένα δελτίο γίνεται κίτρινο / κόκκινο
  station            KitchenStation?
  kdsWarnMin         Int             @default(8)
  kdsLateMin         Int             @default(15)
  active             Boolean         @default(true)
  createdAt          DateTime        @default(now())
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  printer            Printer?        @relation(fields: [printerId], references: [id], onDelete: SetNull)
  sales              Sale[]
  tillShifts         TillShift[]
  tillDayCloses      TillDayClose[]
  calls              Call[]

  @@unique([orgId, series])
  @@index([orgId, storeId])
}

model Warehouse {
  id                   String                @id @default(cuid())
  orgId                String
  // Κωδικός ανά επιχείρηση (π.χ. CENTRAL)· προαιρετικός, βοηθά σε αναφορές και εντάξεις
  code                 String?
  name                 String
  active               Boolean               @default(true)
  createdAt            DateTime              @default(now())
  org                  Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device               Device?               @relation("DeviceWarehouse") // όταν ο χώρος ΕΙΝΑΙ μια συσκευή (ψυγείο, αυτόματος πωλητής)
  // Το απόθεμα ανήκει στην αποθήκη, όχι στο κατάστημα. Ποια καταστήματα εξυπηρετεί (και ποια είναι
  // η προεπιλογή του καθενός) λέει το StoreWarehouse — έτσι μία κεντρική αποθήκη καλύπτει πολλά καταστήματα.
  stores               StoreWarehouse[]
  memberships          MembershipWarehouse[]
  movements            StockMovement[]
  lots                 StockLot[]
  purchases            PurchaseDoc[]
  productionBatches    ProductionBatch[]
  deviceDefaults       Device[]              @relation("DeviceDefaultWarehouse")
  sourceTransfers      StockTransfer[]       @relation("TransferSource")
  destinationTransfers StockTransfer[]       @relation("TransferDestination")
  stockCounts          StockCount[]
  stockThresholds      StockThreshold[]
  spots                StorageSpot[]

  @@unique([orgId, code])
  @@index([orgId])
}

// Αμετάβλητο επιχειρησιακό ίχνος. Τα store/warehouse IDs μένουν ως ιστορική αναφορά ακόμη κι αν αφαιρεθεί η οντότητα.
model AuditEvent {
  id          String       @id @default(cuid())
  orgId       String
  actorId     String?
  actorName   String
  action      String
  entityType  String
  entityId    String
  storeId     String?
  warehouseId String?
  reason      String?
  metadata    Json?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId, entityType, entityId, createdAt])
  @@index([orgId, createdAt])
  @@index([orgId, warehouseId, createdAt])
}

// Σύνδεση καταστήματος με αποθήκη: ποιες αποθήκες επιτρέπονται στο κατάστημα, με ποια σειρά,
// και ποια είναι η προεπιλογή του (μία ανά κατάστημα — επιβάλλεται στο lib/warehouses.ts).
model StoreWarehouse {
  storeId     String
  warehouseId String
  isDefault   Boolean   @default(false)
  priority    Int       @default(100) // μικρότερο = προτιμότερο, όταν δεν υπάρχει προεπιλογή
  createdAt   DateTime  @default(now())
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([storeId, warehouseId])
  @@index([warehouseId])
}

// Κάθε κίνηση αποθέματος. Μόνο προσθήκες· το τρέχον απόθεμα είναι το άθροισμα ανά αποθήκη.
// Η γραμμή κρατά πάντα το ΤΕΛΙΚΟ warehouseId (βλ. resolveWarehouseId) — ποτέ δεν συμπεραίνεται από το κατάστημα.
// documentId/lineId: το παραστατικό που την προκάλεσε (πώληση ή PurchaseDoc/PurchaseLine)· κενά σε χειροκίνητες διορθώσεις.
model StockMovement {
  id                 String             @id @default(cuid())
  orgId              String
  storeId            String? // πώληση: το κατάστημα· αγορά/διόρθωση: κενό (η κίνηση είναι της αποθήκης)
  warehouseId        String
  documentId         String?
  lineId             String?
  transferId         String? // typed σύνδεση· η FK προστίθεται μαζί με το StockTransfer
  transferLineId     String?
  countId            String? // typed σύνδεση· η FK προστίθεται μαζί με το StockCount
  countLineId        String?            @unique
  quantity           Int // θετικό = είσοδος, αρνητικό = έξοδος — σε βασική μονάδα του genericItemId
  unitCostHundredths Int? // ιστορικό κόστος βασικής μονάδας· δεν αλλάζει με τον επόμενο μέσο όρο
  genericItemId      String? // σε ποιο γενικό είδος ανήκει η ποσότητα· κενό μόνο σε legacy sale recording
  lotId              String? // η παρτίδα (StockLot) — κενό για είδη χωρίς παρτίδες
  source             String             @default("sale") // sale | purchase | production | manual | transfer | count
  note               String? // αιτιολογία διόρθωσης («σπασίματα», «μέτρηση απογραφής»…)
  createdById        String?
  createdByName      String? // snapshot ονόματος· μένει και αν διαγραφεί ο χρήστης
  occurredAt         DateTime           @default(now()) // επιχειρησιακή ημερομηνία, μπορεί να είναι παλιότερη
  recordedAt         DateTime           @default(now()) // πραγματική εγγραφή από τη βάση, για snapshot conflict checks
  warehouse          Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lot                StockLot?          @relation(fields: [lotId], references: [id], onDelete: SetNull)
  createdBy          User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  transfer           StockTransfer?     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  transferLine       StockTransferLine? @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  count              StockCount?        @relation(fields: [countId], references: [id], onDelete: Restrict)
  countLine          StockCountLine?    @relation(fields: [countLineId], references: [id], onDelete: Restrict)

  @@unique([orgId, transferLineId, warehouseId])
  @@index([orgId, warehouseId, occurredAt])
  @@index([orgId, storeId, occurredAt])
  @@index([orgId, genericItemId, occurredAt])
  @@index([orgId, warehouseId, genericItemId, lotId])
  @@index([orgId, warehouseId, recordedAt])
  @@index([orgId, transferId])
  @@index([orgId, countId])
  @@index([lotId])
}

// Η απογραφή παγώνει το snapshot· μετά την οριστικοποίηση δεν αλλάζουν header ή γραμμές.
model StockCount {
  id              String           @id @default(cuid())
  orgId           String
  storeId         String?
  warehouseId     String
  countedOn       DateTime         @db.Date
  snapshotAt      DateTime
  status          StockCountStatus @default(DRAFT)
  clientKey       String
  requestHash     String
  note            String?
  createdById     String?
  createdByName   String
  finalizedById   String?
  finalizedByName String?
  finalizedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  org             Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store           Store?           @relation(fields: [storeId], references: [id], onDelete: Restrict)
  warehouse       Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  createdBy       User?            @relation("CountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  finalizedBy     User?            @relation("CountFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  lines           StockCountLine[]
  movements       StockMovement[]
  edits           StockCountEdit[]

  @@unique([orgId, clientKey])
  @@index([orgId, warehouseId, countedOn, status])
  @@index([orgId, storeId, countedOn])
}

// Idempotency των offline measurement edits· το canonical hash εμποδίζει reuse με άλλο payload.
model StockCountEdit {
  id          String       @id @default(cuid())
  orgId       String
  countId     String
  clientKey   String
  requestHash String
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  count       StockCount   @relation(fields: [countId], references: [id], onDelete: Cascade)

  @@unique([orgId, countId, clientKey])
  @@index([orgId, countId, createdAt])
}

model StockCountLine {
  id                 String         @id @default(cuid())
  orgId              String
  countId            String
  genericItemId      String
  lotId              String?
  expectedQty        Int
  actualQty          Int?
  differenceQty      Int?
  unitCostHundredths Int // snapshot σε εκατοστά λεπτού ανά kg/l ή 1.000 τεμάχια
  reason             String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  count              StockCount     @relation(fields: [countId], references: [id], onDelete: Restrict)
  genericItem        GenericItem    @relation(fields: [genericItemId], references: [id], onDelete: Restrict)
  lot                StockLot?      @relation(fields: [lotId], references: [id], onDelete: Restrict)
  movement           StockMovement?

  @@unique([orgId, countId, genericItemId, lotId])
  @@index([orgId, genericItemId])
}

// Ρητό ελάχιστο ανά tenant/warehouse/generic· χωρίς γραμμή δεν παράγεται low-stock alert.
model StockThreshold {
  id            String       @id @default(cuid())
  orgId         String
  warehouseId   String
  genericItemId String
  minimumQty    Int
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  genericItem   GenericItem  @relation(fields: [genericItemId], references: [id], onDelete: Cascade)

  @@unique([orgId, warehouseId, genericItemId])
  @@index([orgId, warehouseId])
}

// Άμεση, οριστική μεταφορά: η ύπαρξή του σημαίνει posted και δημιουργείται μαζί με όλες τις κινήσεις.
model StockTransfer {
  id                     String              @id @default(cuid())
  orgId                  String
  sourceWarehouseId      String
  destinationWarehouseId String
  storeId                String? // πλαίσιο UI· η κίνηση παραμένει warehouse-scoped
  clientKey              String
  requestHash            String
  note                   String?
  createdById            String?
  createdByName          String
  createdAt              DateTime            @default(now())
  org                    Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sourceWarehouse        Warehouse           @relation("TransferSource", fields: [sourceWarehouseId], references: [id], onDelete: Restrict)
  destinationWarehouse   Warehouse           @relation("TransferDestination", fields: [destinationWarehouseId], references: [id], onDelete: Restrict)
  store                  Store?              @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy              User?               @relation(fields: [createdById], references: [id], onDelete: SetNull)
  lines                  StockTransferLine[]
  movements              StockMovement[]

  @@unique([orgId, clientKey])
  @@index([orgId, sourceWarehouseId, createdAt])
  @@index([orgId, destinationWarehouseId, createdAt])
  @@index([orgId, storeId, createdAt])
}

model StockTransferLine {
  id                 String          @id @default(cuid())
  orgId              String
  transferId         String
  genericItemId      String
  sourceLotId        String?
  destinationLotId   String?
  quantity           Int // πάντα > 0, βασική μονάδα
  unitCostHundredths Int // snapshot ανά kg/l ή 1.000 τεμάχια, όχι νέα αγορά
  transfer           StockTransfer   @relation(fields: [transferId], references: [id], onDelete: Restrict)
  genericItem        GenericItem     @relation(fields: [genericItemId], references: [id], onDelete: Restrict)
  sourceLot          StockLot?       @relation("TransferSourceLot", fields: [sourceLotId], references: [id], onDelete: Restrict)
  destinationLot     StockLot?       @relation("TransferDestinationLot", fields: [destinationLotId], references: [id], onDelete: Restrict)
  movements          StockMovement[]

  @@unique([orgId, transferId, genericItemId, sourceLotId])
  @@index([orgId, genericItemId])
}

// Παρτίδα γενικού είδους σε αποθήκη: από πού ήρθε, πότε λήγει (ιχνηλασιμότητα, Καν. 178/2002 αρ. 18).
// Η μοναδικότητα «χωρίς παρτίδα» (batchNumber κενό) επιβάλλεται με partial index στο migration.
model StockLot {
  id                       String                @id @default(cuid())
  orgId                    String
  genericItemId            String
  warehouseId              String
  batchNumber              String? // AI(10) του GS1 ή χειροκίνητη
  expiresAt                DateTime? // AI(17) — η βάση της FEFO πρότασης
  documentId               String? // το τιμολόγιο αγοράς (PurchaseDoc) που την έφερε
  productionBatchId        String? // η παρτίδα παραγωγής που δημιούργησε το output
  holdStatus               StockHoldStatus       @default(AVAILABLE)
  holdReason               String?
  createdAt                DateTime              @default(now())
  org                      Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  genericItem              GenericItem           @relation(fields: [genericItemId], references: [id], onDelete: Cascade)
  warehouse                Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  document                 PurchaseDoc?          @relation(fields: [documentId], references: [id], onDelete: SetNull)
  movements                StockMovement[]
  productionItems          ProductionBatchItem[]
  transferSourceLines      StockTransferLine[]   @relation("TransferSourceLot")
  transferDestinationLines StockTransferLine[]   @relation("TransferDestinationLot")
  countLines               StockCountLine[]

  @@unique([orgId, genericItemId, warehouseId, batchNumber])
  @@index([orgId, expiresAt])
}

enum PurchaseStatus {
  DRAFT // καταχωρείται / αντιστοιχίζεται — δεν έχει ακουμπήσει το απόθεμα
  POSTED // αποδεκτό: γράφτηκαν κινήσεις αποθέματος, παρτίδες και τυχόν νέες τιμές
  CANCELLED
}

// Παραστατικό αγοράς: INVOICE έχει χρηματοοικονομική οφειλή, RECEIPT μόνο την πρώτη εγγραφή αποθέματος.
// Δεν είναι FiscalDocument: εκείνο είναι τα παραστατικά που ΕΚΔΙΔΟΥΜΕ εμείς.
model PurchaseDoc {
  id                 String           @id @default(cuid())
  orgId              String
  supplierId         String
  warehouseId        String // πού μπήκε ή θα μπει το απόθεμα της αγοράς
  kind               String           @default("INVOICE") // INVOICE | RECEIPT — η παραλαβή δεν είναι χρηματοοικονομικό παραστατικό
  number             String? // ο αριθμός τιμολογίου του προμηθευτή ή περιγραφή παραλαβής
  issuedAt           DateTime? // ημερομηνία έκδοσης τιμολογίου / πραγματοποίησης παραλαβής
  status             PurchaseStatus   @default(DRAFT)
  source             String           @default("manual") // manual | ocr | mydata | order | receipt
  note               String?
  mydataMark         String? // μοναδικός αριθμός καταχώρισης myDATA (dedupe στη μηχανογραφημένη λήψη)
  supplierSnapshot   Json? // τα στοιχεία όπως ίσχυαν στο παραστατικό, όχι ζωντανή αναφορά στο Party
  buyerSnapshot      Json?
  paymentMethod      String?
  paymentTerms       String?
  shippingMethod     String?
  shippingAddress    String?
  shippingCostCents  Int              @default(0) // καθαρή αξία προ ΦΠΑ
  otherExpensesCents Int              @default(0) // καθαρή αξία προ ΦΠΑ
  expensesVatRate    Int              @default(24) // snapshot συντελεστή των εξόδων
  // Επιστροφές και πιστωτικά προμηθευτή (lib/purchase-returns.ts)
  relatedId          String? // RETURN/CREDIT: το τιμολόγιο αγοράς που αφορούν (στο 5.2: αυτό με το οποίο συμψηφίζεται)
  returnId           String? // CREDIT: η επιστροφή μας που κλείνει
  fiscalDocumentId   String?          @unique // RETURN: το δικό μας 9.3 με σκοπό «Επιστροφή»
  mydataType         String? // ο τύπος ΑΑΔΕ του προμηθευτή: 1.1, 5.1, 5.2
  relatedMark        String? // από το myDATA: το MARK που πιστώνει (πρόταση σύνδεσης)
  stockMode          String? // CREDIT: returned (με επιστροφή μας) | now (επιστρέφονται τώρα) | value (μόνο αξία)
  creditCents        Int              @default(0) // INVOICE: σύνολο καταχωρημένων πιστωτικών που το μειώνουν
  createdByName      String
  createdAt          DateTime         @default(now())
  related            PurchaseDoc?     @relation("PurchaseRelated", fields: [relatedId], references: [id], onDelete: Restrict)
  derived            PurchaseDoc[]    @relation("PurchaseRelated")
  returnDoc          PurchaseDoc?     @relation("PurchaseReturnCredit", fields: [returnId], references: [id], onDelete: Restrict)
  credits            PurchaseDoc[]    @relation("PurchaseReturnCredit")
  fiscalDocument     FiscalDocument?  @relation(fields: [fiscalDocumentId], references: [id], onDelete: Restrict)
  org                Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier           Party            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouse          Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  lines              PurchaseLine[]
  lots               StockLot[]
  receiptInvoice     PurchaseReceipt? @relation("PurchaseReceiptInvoice")
  orderInvoice       PurchaseOrder?   @relation("PurchaseOrderInvoice")
  mydataCheck        MydataCheck?
  mydataIncoming     MydataIncoming?

  @@unique([orgId, mydataMark])
  @@index([orgId, supplierId, createdAt])
  @@index([orgId, relatedId])
  @@index([orgId, kind, status, issuedAt])
}

// Γραμμή τιμολογίου αγοράς: όπως ήρθε από τον προμηθευτή + η αντιστοίχισή της (lib/purchases.ts).
model PurchaseLine {
  id             String                    @id @default(cuid())
  orgId          String
  documentId     String
  supplierCode   String? // ο κωδικός του προμηθευτή όπως τυπώθηκε
  ean            String? // EAN/GTIN της συσκευασίας (σάρωση ή πεδίο του παραστατικού)
  description    String // η περιγραφή όπως ήρθε από τον προμηθευτή
  quantity       Int // σε μονάδα παραστατικού (π.χ. κιβώτια) — βλ. packQty του SupplierItem
  unitPriceCents Int // αρχική τιμή μονάδας παραστατικού, προ έκπτωσης και ΦΠΑ, σε λεπτά
  discountBps    Int                       @default(0) // έκπτωση γραμμής σε basis points: 1250 = 12,50%
  vatRate        Int                       @default(0) // snapshot ποσοστού ΦΠΑ· 0 σημαίνει μηδενικός συντελεστής
  // Ιχνηλασιμότητα: από GS1 σάρωση ή χειροκίνητα — τροφοδοτούν το StockLot της παραλαβής
  batchNumber    String?
  expiresAt      DateTime?
  // Έλεγχος παραλαβής HACCP (Καν. 852/2004 αρ. 5, οδηγοί ΕΦΕΤ)
  receiptTempC   Float? // °C κατά την παραλαβή (ευπαθή/ψυγόμενα)
  receiptIssue   String? // π.χ. «σχισμένη συσκευασία»· κενό = χωρίς πρόβλημα
  // Η αντιστοίχιση (μέθοδος στο matchNote)
  supplierItemId String?
  tradeItemId    String?
  genericItemId  String? // τελικό: πού «πέφτει» το απόθεμα
  matchNote      String? // code | ean | manual — πώς βρέθηκε (για μάθηση/έλεγχο)
  sourceLineId   String? // RETURN/CREDIT: η γραμμή του αρχικού τιμολογίου (όριο επιστρεφόμενης ποσότητας)
  document       PurchaseDoc               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  supplierItem   SupplierItem?             @relation(fields: [supplierItemId], references: [id], onDelete: SetNull)
  tradeItem      TradeItem?                @relation(fields: [tradeItemId], references: [id], onDelete: SetNull)
  genericItem    GenericItem?              @relation(fields: [genericItemId], references: [id], onDelete: SetNull)
  invoiceMatch   PurchaseInvoiceLineMatch?

  @@index([orgId, documentId])
  @@index([orgId, supplierCode])
}

enum ReadingKind {
  TEMPERATURE // °C
  WEIGHT // kg
}

// Μετρήσεις που στέλνουν οι συσκευές (θερμοκρασίες ψυγείων, ζυγίσεις).
// shortcut: απλός πίνακας με ευρετήριο· όταν οι μετρήσεις γίνουν εκατομμύρια, γίνεται hypertable (TimescaleDB) με πολιτική διατήρησης.
model Reading {
  id       String      @id @default(cuid())
  orgId    String
  deviceId String
  kind     ReadingKind
  value    Float
  at       DateTime    @default(now())
  device   Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, at])
}

// Θερμικός εκτυπωτής (ESC/POS). Τον χρησιμοποιεί η εφαρμογή Android· ο browser τυπώνει μέσω του συστήματος.
model Printer {
  id         String            @id @default(cuid())
  orgId      String
  storeId    String
  name       String
  connection PrinterConnection
  address    String? // 192.168.1.50:9100 ή AA:BB:CC:DD:EE:FF· κενό για USB
  paperWidth Int               @default(80) // mm: 58 ή 80
  role       PrinterRole       @default(RECEIPTS)
  active     Boolean           @default(true)
  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  devices    Device[]

  @@index([orgId, storeId])
}

model Category {
  id       String          @id @default(cuid())
  orgId    String
  name     String
  position Int             @default(0)
  color    Int? // θέση 1–8 στη σταθερή λίστα χρωμάτων του ταμείου (mobile/theme.ts)· κενό = από τη σειρά της
  station  KitchenStation? // ποια οθόνη κουζίνας φτιάχνει τα είδη της· κενό = δεν πάει σε οθόνη (π.χ. παγωτό από τη βιτρίνα)
  org      Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([orgId])
}

model Product {
  id             String                 @id @default(cuid())
  orgId          String
  categoryId     String
  vatRateId      String
  name           String
  priceCents     Int // τελική τιμή με ΦΠΑ
  code           String? // σύντομος κωδικός στο πλήκτρο του ταμείου, π.χ. «Χ2»
  active         Boolean                @default(true)
  org            Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category       Category               @relation(fields: [categoryId], references: [id])
  vatRate        VatRate                @relation(fields: [vatRateId], references: [id])
  lines          SaleLine[]
  billLines      BillLine[]
  recipes        Recipe[]
  modifierGroups ProductModifierGroup[]

  @@index([orgId, categoryId])
}

model Sale {
  id         String          @id @default(cuid())
  orgId      String
  storeId    String
  deviceId   String
  status     SaleStatus      @default(DRAFT)
  totalCents Int             @default(0)
  // Συμπληρώνονται στην έκδοση
  series     String?
  aa         Int?
  issuedAt   DateTime?
  // Πληρωμή ανοιχτού λογαριασμού (τραπέζι/κουβάς): ένας λογαριασμός κλείνει με μία ή περισσότερες αποδείξεις
  billId     String?
  createdAt  DateTime        @default(now())
  bill       Bill?           @relation(fields: [billId], references: [id], onDelete: SetNull)
  org        Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store      Store           @relation(fields: [storeId], references: [id])
  device     Device          @relation(fields: [deviceId], references: [id])
  lines      SaleLine[]
  payment    Payment? // η χρέωση της στιγμής της έκδοσης (στο μοίρασμα κατά ποσό: μόνο το υπόλοιπο)
  shares     BillShare[] // ό,τι εισπράχθηκε πριν (μοίρασμα κατά ποσό)
  fiscal     FiscalDocument?

  @@unique([deviceId, series, aa])
  @@index([orgId, status, issuedAt])
  @@index([deviceId, status])
  @@index([orgId, storeId, issuedAt]) // αναφορές ανά κατάστημα
}

// Επιλογές προϊόντος στο ταμείο (spec κεντρικού ταμείου §3). Η ομάδα είναι κοινή για την επιχείρηση («Γεύσεις»)
// και συνδέεται με όσα προϊόντα τη χρειάζονται· το πόσες επιλογές παίρνει ορίζεται στη σύνδεση (χωνάκι 1 ή 2 μπάλες).
enum ModifierKind {
  REQUIRED // υποχρεωτική: ακριβώς `pick` επιλογές, η ίδια μπορεί να μπει δύο φορές
  EXTRA // προαιρετικά έξτρα με χρέωση, το καθένα μία φορά
  REMOVE // προαιρετική αφαίρεση («χωρίς ζάχαρη»), χωρίς χρέωση
}

model ModifierGroup {
  id       String                 @id @default(cuid())
  orgId    String
  name     String
  kind     ModifierKind
  position Int                    @default(0)
  org      Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  options  ModifierOption[]
  products ProductModifierGroup[]

  @@index([orgId])
}

model ModifierOption {
  id         String        @id @default(cuid())
  groupId    String
  name       String
  priceCents Int           @default(0) // επιπλέον χρέωση με ΦΠΑ· ο ΦΠΑ είναι του προϊόντος
  position   Int           @default(0)
  active     Boolean       @default(true) // ανενεργή = δεν φαίνεται στο ταμείο (π.χ. τελείωσε η γεύση)
  group      ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model ProductModifierGroup {
  productId String
  groupId   String
  pick      Int           @default(1) // μόνο για REQUIRED: πόσες ακριβώς
  position  Int           @default(0)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
  @@index([groupId])
}

model SaleLine {
  id             String    @id @default(cuid())
  saleId         String
  productId      String
  name           String // αντίγραφο ονόματος τη στιγμή της πώλησης
  quantity       Int
  unitPriceCents Int
  vatRate        Int
  // Οι επιλογές της γραμμής όπως ήταν τη στιγμή της πώλησης: [{ name, priceCents }]. Η τιμή τους είναι ήδη μέσα στο unitPriceCents.
  options        Json?
  note           String?
  billLineId     String? // από ποια γραμμή του λογαριασμού πληρώθηκε (μπορεί μέρος της ποσότητας)
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product        Product   @relation(fields: [productId], references: [id])
  billLine       BillLine? @relation(fields: [billLineId], references: [id], onDelete: SetNull)

  // το ίδιο προϊόν μπαίνει σε πολλές γραμμές με διαφορετικές επιλογές (χωνάκι φιστίκι, χωνάκι φράουλα)
  @@index([saleId])
  @@index([productId]) // πωλήσεις ανά προϊόν (σελίδα παραγωγής)
  @@index([billLineId])
}

// Τραπέζι καταστήματος. Η ζώνη («Σάλα», «Βεράντα») είναι ελεύθερο κείμενο: ομαδοποιεί την κάτοψη στο ταμείο.
model DiningTable {
  id           String        @id @default(cuid())
  orgId        String
  storeId      String
  name         String // «6», «Β3»
  zone         String?
  seats        Int           @default(4)
  position     Int           @default(0)
  active       Boolean       @default(true)
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bills        Bill[]
  reservations Reservation[]

  @@unique([storeId, name])
  @@index([orgId, storeId])
}

enum BillStatus {
  OPEN
  SETTLED // πληρώθηκαν όλες οι γραμμές
  CANCELLED // ακυρώθηκε χωρίς πληρωμή (όλες οι γραμμές ακυρωμένες)
}

enum ReservationStatus {
  BOOKED // κλεισμένη, περιμένουμε
  SEATED // ήρθαν και κάθισαν: έχει ανοιχτό λογαριασμό
  DONE // έφυγαν (έκλεισε ο λογαριασμός)
  NO_SHOW // δεν ήρθαν
  CANCELLED
}

// Κράτηση τραπεζιού. Το τραπέζι είναι προαιρετικό (δίνεται και όταν έρθουν)· στο «ήρθαν» ανοίγει λογαριασμός
// στο τραπέζι και δένεται εδώ. Όνομα και τηλέφωνο είναι προσωπικά δεδομένα: η λίστα του ταμείου κρύβει το τηλέφωνο.
model Reservation {
  id            String            @id @default(cuid())
  orgId         String
  storeId       String
  tableId       String?
  startsAt      DateTime
  durationMin   Int               @default(90)
  guests        Int
  name          String
  phone         String?
  note          String?
  status        ReservationStatus @default(BOOKED)
  billId        String?           @unique
  createdByName String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table         DiningTable?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  bill          Bill?             @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([orgId, storeId, startsAt])
  @@index([tableId, startsAt])
  @@index([orgId, phone])
}

// Ανοιχτός λογαριασμός («κουβάς»): μαζεύει παραγγελίες από ταμείο και σερβιτόρους μέχρι να πληρωθεί.
// Ζει στον server, ώστε κάθε συσκευή του καταστήματος να βλέπει το ίδιο. Τραπέζι προαιρετικό (πακέτο, μπαρ).
model Bill {
  id            String       @id @default(cuid())
  orgId         String
  storeId       String
  tableId       String?
  label         String? // όταν δεν είναι τραπέζι: «Κώστας, πακέτο»
  guests        Int?
  status        BillStatus   @default(OPEN)
  openedByName  String?
  waiterId      String? // ο υπάλληλος της βάρδιας που το άνοιξε: «τα δικά μου» στο κινητό του σερβιτόρου
  openedAt      DateTime     @default(now())
  closedAt      DateTime?
  billAskedAt   DateTime? // ο πελάτης ζήτησε λογαριασμό: μπαίνει στο «Σε περιμένουν» σερβιτόρου και ταμία
  billAskedCash Boolean      @default(false) // θα πληρώσει μετρητά: τα εισπράττει ο ταμίας (ο σερβιτόρος δεν κρατά συρτάρι)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  table         DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  rounds        BillRound[]
  lines         BillLine[]
  sales         Sale[]
  shares        BillShare[]
  reservation   Reservation?
  order         Order?

  @@index([orgId, storeId, status])
  @@index([tableId, status])
}

enum BillShareStatus {
  PENDING // στο τερματικό τώρα
  PAID // εισπράχθηκε· περιμένει την απόδειξη του υπολοίπου
  FAILED
}

// Μοίρασμα κατά ποσό: μέρος του λογαριασμού που εισπράττεται ΠΡΙΝ από την απόδειξη (Viva: «payment protocol» χωρίς
// είδη, δικό του transactionId). Η απόδειξη του υπολοίπου τα γράφει όλα στα cbPayItems· τότε δένονται με αυτήν (saleId).
model BillShare {
  id                String          @id @default(cuid())
  orgId             String
  storeId           String
  billId            String
  deviceId          String
  methodId          String
  amountCents       Int
  reference         String          @unique // cbReceiptReference του πρωτοκόλλου = sessionId της Viva
  status            BillShareStatus @default(PENDING)
  vivaTransactionId String?
  saleId            String? // η απόδειξη που το περιλαμβάνει (δεσμεύεται στην έκδοση, ελευθερώνεται αν αποτύχει)
  raw               Json?
  createdAt         DateTime        @default(now())
  paidAt            DateTime?
  bill              Bill            @relation(fields: [billId], references: [id], onDelete: Restrict)
  sale              Sale?           @relation(fields: [saleId], references: [id], onDelete: SetNull)
  method            PaymentMethod   @relation(fields: [methodId], references: [id], onDelete: Restrict)

  @@index([billId, status])
  @@index([deviceId, status])
  @@index([saleId])
}

// Μία «αποστολή» του λογαριασμού: ό,τι παραγγέλθηκε μαζί. Θα γίνει το Δελτίο Παραγγελίας 8.6 όταν μπει η διαβίβαση.
model BillRound {
  id         String          @id @default(cuid())
  billId     String
  number     Int
  deviceId   String // ποια συσκευή την έστειλε (ταμείο ή κινητό σερβιτόρου)
  sentByName String?
  sentAt     DateTime        @default(now()) // σε αποστολή «Μετά»: η ώρα που βγήκε («Βγάλ' το»)
  held       Boolean         @default(false) // «Μετά»: γράφτηκε αλλά δεν πήγε σε κουζίνα/bar· χωρίς 8.6 και εκτός λογαριασμού ως το «Βγάλ' το»
  bill       Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  lines      BillLine[]
  orderSlip  FiscalDocument? // 8.6 της αποστολής

  @@unique([billId, number])
}

model BillLine {
  id             String     @id @default(cuid())
  billId         String
  roundId        String
  productId      String
  name           String // αντίγραφο τη στιγμή της παραγγελίας, όπως στο SaleLine
  quantity       Int
  unitPriceCents Int
  vatRate        Int
  options        Json?
  note           String?
  seat           Int? // θέση στο τραπέζι (1, 2, …)· κενό = για όλο το τραπέζι
  readyAt        DateTime? // η κουζίνα/bar το ετοίμασε (οθόνη κουζίνας)
  servedAt       DateTime? // ο σερβιτόρος το σερβίρισε
  voidedAt       DateTime? // ακυρώθηκε πριν πληρωθεί
  voidReason     String?
  bill           Bill       @relation(fields: [billId], references: [id], onDelete: Cascade)
  round          BillRound  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  product        Product    @relation(fields: [productId], references: [id])
  saleLines      SaleLine[]

  @@index([billId])
  @@index([productId])
}

// «Τελείωσε»: προϊόν ή επιλογή (γεύση) που δεν υπάρχει σήμερα στο κατάστημα. Το πατά όποιος έχει βάρδια στη συσκευή·
// οι σερβιτόροι το βλέπουν διαγραμμένο πριν το πατήσουν και ο server δεν δέχεται παραγγελία του.
model SoldOut {
  id        String   @id @default(cuid())
  orgId     String
  storeId   String
  itemId    String // Product.id ή ModifierOption.id
  byName    String?
  createdAt DateTime @default(now())
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, itemId])
}

model Payment {
  id                String        @id @default(cuid())
  saleId            String        @unique
  methodId          String // ο τρόπος πληρωμής από την κοινή λίστα της πλατφόρμας
  amountCents       Int
  vivaSessionId     String?       @unique
  vivaTransactionId String?
  success           Boolean       @default(false)
  raw               Json? // η απάντηση της Viva όπως ήρθε
  createdAt         DateTime      @default(now())
  sale              Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method            PaymentMethod @relation(fields: [methodId], references: [id], onDelete: Restrict)
}

// Κοινός πίνακας τύπων παραστατικών myDATA (επίπεδο πλατφόρμας, όπως VatRate/PaymentMethod).
// Οι φορολογικοί κανόνες (πρόσημο, συναλλασσόμενος, συσχέτιση) είναι τεκμηρίωση: σπέρνονται
// από migration και δεν αλλάζουν από οθόνη· διαχειρίσιμα είναι μόνο τίτλος, receiptCase, active.
// receiptCase κενό = ο τύπος δεν εκδίδεται ακόμη (χρειάζεται επαληθευμένο δείγμα από τη Viva).
model DocumentType {
  id           String   @id @default(cuid())
  code         String   @unique // κωδικός myDATA, π.χ. "11.1"
  title        String
  sign         Int // 1 χρεωστικό, -1 πιστωτικό
  retail       Boolean // 11.x — μη αντικριζόμενο λιανικής
  needsParty   Boolean // απαιτεί συναλλασσόμενο με ΑΦΜ
  needsRelated Boolean // συσχετιζόμενο πιστωτικό: απαιτεί το αρχικό παραστατικό
  receiptCase  String? // ftReceiptCase της Viva (δεκαδικό Int64 ως κείμενο: ξεπερνά το Number)
  active       Boolean  @default(true)
  sort         Int      @default(0)
  createdAt    DateTime @default(now())
}

// Σειρά αρίθμησης παραστατικών εκτός ταμείου (τιμολόγια, πιστωτικά, δελτία αποστολής).
// Οι αποδείξεις POS αριθμούνται από τη συσκευή (Device.series/nextAa)· εδώ οι υπόλοιποι τύποι,
// ξεχωριστά ανά τύπο και χαρακτήρα σειράς, όπως απαιτεί η ΑΑΔΕ (lib/documents/series.ts).
model DocumentSeries {
  id        String           @id @default(cuid())
  orgId     String? // κενό = σειρά της πλατφόρμας (τιμολόγηση συνδρομών), όπως στο Party
  storeId   String?
  docType   String // κωδικός myDATA: "1.1", "2.1", "5.1", "11.4"…
  code      String // ο χαρακτήρας σειράς, π.χ. "ΤΙΜ-Α"
  name      String? // περιγραφή για τις οθόνες
  nextAa    Int              @default(1)
  active    Boolean          @default(true) // ανενεργή δεν προτείνεται και δεν εκδίδει
  isDefault Boolean          @default(false) // προτείνεται για τον τύπο (στο κατάστημα, αν έχει)
  transmit  Boolean          @default(true) // false = εσωτερική σειρά, δεν διαβιβάζεται (χρεοπιστώσεις)
  org       Organization?    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store     Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  documents FiscalDocument[]

  @@unique([orgId, docType, code]) // για την πλατφόρμα (orgId κενό) τη μοναδικότητα την κρατά μερικός δείκτης στο migration
}

// Φορολογικό παραστατικό διαβίβασης: απόδειξη POS (με Sale) ή τιμολόγιο/πιστωτικό/δελτίο
// (με Party). Ο τύπος και οι κανόνες του στο lib/documents/types.ts.
model FiscalDocument {
  id               String              @id @default(cuid())
  orgId            String? // κενό = παραστατικό της πλατφόρμας προς συνδρομητή
  chargeId         String?             @unique // τιμολόγιο συνδρομής: η χρέωση που τιμολογεί
  aa               Int? // ο αριθμός στη σειρά (οι αποδείξεις POS τον έχουν στο request)
  totalCents       Int? // σύνολο με ΦΠΑ, με το πρόσημο του τύπου
  mark             String? // MARK της ΑΑΔΕ μετά τη διαβίβαση· με αυτό συσχετίζονται τα πιστωτικά
  saleId           String?             @unique // κενό σε τιμολόγια χονδρικής/συνδρομών: δεν προέρχονται από ταμείο
  partyId          String? // ο συναλλασσόμενος για αντικριζόμενα (1.x, 2.x, 5.x) και απλοποιημένο (11.3)
  seriesId         String? // κενή για αποδείξεις POS: η σειρά τους είναι της συσκευής
  docType          String              @default("11.1") // κωδικός myDATA
  billRoundId      String?             @unique // 8.6: η αποστολή στο τραπέζι που παραγγέλνει (τα ακυρωτικά 8.6 τη βρίσκουν μέσω relatedId)
  relatedId        String? // 5.1/11.4: το αρχικό παραστατικό που πιστώνεται (συσχετιζόμενο)
  receiptReference String              @unique // cbReceiptReference: με αυτό συσχετίζονται τα πιστωτικά
  status           FiscalStatus
  request          Json // το fiscalisationData που στείλαμε
  response         Json? // ftState, ftSignatures, QR κ.λπ.
  error            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt // η επανάληψη διαβιβάσεων μετρά από εδώ την αναμονή
  org              Organization?       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  charge           SubscriptionCharge? @relation(fields: [chargeId], references: [id], onDelete: Restrict)
  sale             Sale?               @relation(fields: [saleId], references: [id], onDelete: Cascade)
  party            Party?              @relation(fields: [partyId], references: [id], onDelete: SetNull)
  series           DocumentSeries?     @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  related          FiscalDocument?     @relation("DocumentCredit", fields: [relatedId], references: [id], onDelete: SetNull)
  billRound        BillRound?          @relation(fields: [billRoundId], references: [id], onDelete: SetNull)
  creditedBy       FiscalDocument[]    @relation("DocumentCredit")
  purchaseReturn   PurchaseDoc? // 9.3 επιστροφής σε προμηθευτή

  @@index([orgId, docType, createdAt])
}

/// Ημερολόγιο διαβιβάσεων: το γράφει trigger σε κάθε αλλαγή κατάστασης FiscalDocument (migration fiscal_attempt_log). Μόνο ανάγνωση από τον κώδικα.
model FiscalAttempt {
  id               BigInt        @id @default(autoincrement())
  orgId            String?
  fiscalDocumentId String // χωρίς FK: το ίχνος μένει κι αν σβηστεί το παραστατικό
  docType          String
  fromStatus       FiscalStatus?
  toStatus         FiscalStatus
  mark             String?
  error            String?
  at               DateTime      @default(now())
  org              Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, at])
  @@index([fiscalDocumentId])
}

model Subscription {
  id               String               @id @default(cuid())
  orgId            String               @unique
  status           SubscriptionStatus   @default(TRIALING)
  currentPeriodEnd DateTime
  planId           String? // κενό = το προεπιλεγμένο πακέτο
  creditCents      Int                  @default(0) // πιστωτικό υπόλοιπο (έκπτωση παύσης που ξεπέρασε τη χρέωση ενός μήνα)
  plan             Plan?                @relation(fields: [planId], references: [id], onDelete: Restrict)
  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  charges          SubscriptionCharge[]
}

// Μηνιαία χρέωση: «φωτογραφία» του πλήθους καταστημάτων και συσκευών εκείνη τη στιγμή.
model SubscriptionCharge {
  id                String          @id @default(cuid())
  subscriptionId    String
  periodStart       DateTime
  periodEnd         DateTime
  stores            Int
  devices           Int
  amountCents       Int // προ ΦΠΑ
  lines             Json? // ανάλυση ανά κατάστημα: πλήρης τιμή, ημέρες παύσης, έκπτωση (lib/plans.ts)
  planName          String?
  paidAt            DateTime?
  // Πληρωμή με κάρτα στον λογαριασμό Viva της πλατφόρμας (Smart Checkout)
  vivaOrderCode     String?         @unique
  vivaTransactionId String?
  invoice           FiscalDocument?
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, periodStart])
}

// Αρχείο αποθηκευμένο στο Bunny. Η βάση κρατά μόνο πού βρίσκεται και σε τι ανήκει· τα bytes ζουν στο Bunny,
// στον φάκελο του πελάτη (orgs/<orgId>/…) ή της πλατφόρμας (platform/…). Βλ. lib/storage.
model StoredFile {
  id           String        @id @default(cuid())
  orgId        String? // κενό = αρχείο της πλατφόρμας (π.χ. αντίγραφο ασφαλείας)
  category     String // κλειδί του CATEGORIES (lib/storage/rules.ts)
  refType      String? // σε τι ανήκει, π.χ. "product"· μαζί με το refId δένει το αρχείο σε οποιαδήποτε εγγραφή
  refId        String?
  path         String        @unique // διαδρομή μέσα στη ζώνη του Bunny
  name         String // το όνομα που έδωσε ο χρήστης
  contentType  String
  size         Int
  public       Boolean // true = σερβίρεται από το CDN· false = μόνο μέσα από την εφαρμογή
  uploadedById String?
  createdAt    DateTime      @default(now())
  org          Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, category, refType, refId])
}

// ---- GDPR: συναινέσεις, αιτήματα διαγραφής και ημερολόγιο. Ένα σύστημα για δύο επίπεδα:
// orgId = null → υποκείμενα της πλατφόρμας (προσωπικό, λογαριασμοί χωρίς επιχείρηση)· orgId = πελάτης → δικά του υποκείμενα
// (το προσωπικό του και οι πελάτες του). Το υποκείμενο ορίζεται με (subjectType, subjectId), όπως τα αρχεία με (refType, refId),
// ώστε κάθε νέα ενότητα (π.χ. πελάτες χονδρικής) να μπαίνει χωρίς αλλαγή στη βάση. Βλ. lib/gdpr.

// Κάθε γραμμή είναι ένα γεγονός (δόθηκε ή ανακλήθηκε)· δεν αλλάζει ποτέ. Η τρέχουσα κατάσταση είναι η πιο πρόσφατη ανά σκοπό.
model Consent {
  id          String   @id @default(cuid())
  orgId       String?
  subjectType String // "user", "customer", …
  subjectId   String
  purpose     String // κλειδί του PURPOSES (lib/gdpr/rules.ts)
  version     String
  granted     Boolean
  source      String // από πού ήρθε: activation, self, admin
  ip          String?
  userAgent   String?
  at          DateTime @default(now())

  @@index([orgId, subjectType, subjectId, purpose, at])
}

enum ErasureStatus {
  PENDING
  REJECTED
  COMPLETED
}

// Αίτημα διαγραφής (δικαίωμα στη λήθη). Μετά την ολοκλήρωση το όνομα σβήνεται· μένει μόνο αποτύπωμα, ως απόδειξη ότι έγινε.
model ErasureRequest {
  id            String        @id @default(cuid())
  orgId         String?
  subjectType   String
  subjectId     String? // κενό για υποκείμενο που δεν έχει εγγραφή στην εφαρμογή (δεδομένα εκτός συστήματος)
  subjectLabel  String? // όνομα · email όσο το αίτημα είναι ανοιχτό
  subjectHash   String // sha256 του email (ή του ονόματος): αναγνωρίζει επανάληψη αιτήματος χωρίς να κρατά το ίδιο το στοιχείο
  reason        String?
  requestedById String?
  status        ErasureStatus @default(PENDING)
  requestedAt   DateTime      @default(now())
  dueAt         DateTime // ένας μήνας από το αίτημα (άρθρο 12 παρ. 3 ΓΚΠΔ)
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  summary       Json? // τι σβήστηκε, σε αριθμούς

  @@index([orgId, status, dueAt])
}

// Ημερολόγιο: ποιος έκανε τι, πότε, για ποιο υποκείμενο. Μόνο προσθήκες.
model GdprEvent {
  id           String   @id @default(cuid())
  at           DateTime @default(now())
  orgId        String?
  type         String // κλειδί του EVENTS (lib/gdpr/rules.ts)
  actorId      String?
  actorLabel   String
  subjectType  String?
  subjectId    String?
  subjectLabel String?
  detail       Json?

  @@index([orgId, at])
  @@index([subjectType, subjectId])
}

// Προσωπικά δεδομένα συναλλασσομένων: συναινέσεις, αρχεία και διαγραφή περνούν από το κοινό σύστημα GDPR με
// subjectType = "customer" (lib/gdpr) και refType = "customer" (lib/storage). Το κλειδί «customer» έμεινε από τότε που
// υπήρχαν μόνο πελάτες· σημαίνει «συναλλασσόμενος» όποιου ρόλου.
// Συναλλασσόμενος: ΚΟΙΝΟ μοντέλο για όποιον συναλλάσσεται μια επιχείρηση ή η ίδια η πλατφόρμα.
// orgId = η επιχείρηση που τον έχει στο αρχείο της· orgId κενό = συναλλασσόμενος της πλατφόρμας (οι συνδρομητές της,
// οι προμηθευτές και οι συνεργάτες της). Ένας συναλλασσόμενος έχει έναν ή περισσότερους ρόλους (lib/parties.ts).
model Party {
  id                 String             @id @default(cuid())
  orgId              String?
  roles              String[] // customer, supplier, franchisee, partner…
  name               String // επωνυμία ή ονοματεπώνυμο
  tradeName          String? // διακριτικός τίτλος
  vatNumber          String? // ΑΦΜ (χωρίς πρόθεμα χώρας)
  countryCode        String             @default("GR") // ISO 3166-1 alpha-2· για ΑΦΜ άλλης χώρας της ΕΕ ο έλεγχος γίνεται στο VIES
  taxOffice          String? // ΔΟΥ
  profession         String? // δραστηριότητα
  contactName        String? // υπεύθυνος επικοινωνίας (ο κύριος· οι υπόλοιποι στο PartyContact)
  email              String?
  phone              String?
  website            String?
  address            String? // έδρα (οι υπόλοιπες διευθύνσεις στο PartyAddress)
  city               String?
  postalCode         String?
  // Γεωγραφικά: περιοχή (νομός ή περιφέρεια) για αναφορές και συντεταγμένες (WGS84) για χάρτη και δρομολόγια
  region             String?
  latitude           Float?
  longitude          Float?
  // Σύνδεση με τη γεωγραφία αναφοράς (Geo*): Δήμος/Νομός Καλλικράτη, πόλη και περιοχή από τις κοινές λίστες.
  // Τα city/region κείμενο μένουν ως «φωτογραφία» για παραστατικά και αναζήτηση· η αλήθεια είναι οι κωδικοί.
  regionCode         String?
  geoRegion          GeoRegion?         @relation(fields: [regionCode], references: [code], onDelete: SetNull)
  cityId             String?
  geoCity            GeoCity?           @relation(fields: [cityId], references: [id], onDelete: SetNull)
  areaId             String?
  geoArea            GeoArea?           @relation(fields: [areaId], references: [id], onDelete: SetNull)
  geocodedAt         DateTime? // πότε βρέθηκαν οι συντεταγμένες από την υπηρεσία χάρτη
  paymentTermsDays   Int? // ημέρες πίστωσης
  leadTimeDays       Int?
  orderDays          Int[]              @default([])
  deliveryDays       Int[]              @default([])
  minOrderValueCents Int?
  creditLimitCents   Int?
  paymentMethodId    String? // προεπιλεγμένος τρόπος πληρωμής, από την κοινή λίστα της πλατφόρμας
  paymentMethod      PaymentMethod?     @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  notes              String?
  active             Boolean            @default(true)
  // Συναλλασσόμενος της πλατφόρμας που ΕΙΝΑΙ συνδρομητής: δένει με την επιχείρησή του
  linkedOrgId        String?            @unique
  vatCheckedAt       DateTime? // πότε επιβεβαιώθηκαν τα στοιχεία από ΑΑΔΕ ή VIES
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  org                Organization?      @relation("OrgParties", fields: [orgId], references: [id], onDelete: Cascade)
  linkedOrg          Organization?      @relation("OrgAsParty", fields: [linkedOrgId], references: [id], onDelete: Cascade)
  addresses          PartyAddress[]
  contacts           PartyContact[]
  channels           PartyChannel[]
  activities         PartyActivity[]
  offPremiseOrders   Order[]
  calls              Call[]
  bankAccounts       PartyBankAccount[]
  fiscalDocuments    FiscalDocument[]
  supplierItems      SupplierItem[] // τα είδη που πουλά ως προμηθευτής
  purchaseDocs       PurchaseDoc[] // τα τιμολόγια αγοράς από αυτόν

  @@unique([orgId, vatNumber])
  @@index([orgId, name])
}

model PartyAddress {
  id          String         @id @default(cuid())
  partyId     String
  kind        String // branch, delivery, billing, other (lib/parties.ts)
  // Υποκατάστημα: ο αριθμός εγκατάστασης όπως είναι δηλωμένος στην εφορία (η έδρα είναι 0 και ζει στο Party)·
  // με αυτόν δηλώνεται ο αντισυμβαλλόμενος στα παραστατικά (myDATA «branch»)
  branchNo    Int?
  label       String? // π.χ. «Κατάστημα Γλυφάδας»
  phone       String?
  email       String?
  street      String
  city        String?
  postalCode  String?
  countryCode String         @default("GR")
  region      String? // νομός ή περιφέρεια
  latitude    Float?
  longitude   Float?
  // Γεωγραφία αναφοράς (Geo*), όπως στο Party
  regionCode  String?
  geoRegion   GeoRegion?     @relation(fields: [regionCode], references: [code], onDelete: SetNull)
  cityId      String?
  geoCity     GeoCity?       @relation(fields: [cityId], references: [id], onDelete: SetNull)
  areaId      String?
  geoArea     GeoArea?       @relation(fields: [areaId], references: [id], onDelete: SetNull)
  geocodedAt  DateTime?
  notes       String?
  party       Party          @relation(fields: [partyId], references: [id], onDelete: Cascade)
  contacts    PartyContact[]
  channels    PartyChannel[]

  @@unique([partyId, branchNo])
  @@index([partyId])
}

// Πρόσωπο επικοινωνίας, ανεξάρτητο από εταιρία (όπως στο SoftOne): ο ίδιος άνθρωπος, π.χ. ένας λογιστής,
// δένει με πολλούς συναλλασσόμενους μέσω PartyContact και καταχωρείται μία φορά.
model Person {
  id         String          @id @default(cuid())
  orgId      String? // σε ποιο αρχείο ανήκει: επιχείρησης, ή (κενό) της πλατφόρμας
  name       String
  notes      String?
  createdAt  DateTime        @default(now())
  org        Organization?   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  links      PartyContact[]
  channels   PartyChannel[]
  activities PartyActivity[]

  @@index([orgId, name])
}

// Η σχέση προσώπου με συναλλασσόμενο: τι ιδιότητα έχει εκεί και σε ποιο υποκατάστημα βρίσκεται.
model PartyContact {
  id        String        @id @default(cuid())
  partyId   String
  personId  String
  title     String? // ιδιότητα σε αυτή την εταιρία, π.χ. «Λογιστήριο»
  addressId String? // σε ποιο υποκατάστημα ή διεύθυνση βρίσκεται· κενό = στην έδρα
  isPrimary Boolean       @default(false) // η κύρια επαφή της εταιρίας (μία)
  active    Boolean       @default(true) // false = δεν εργάζεται πλέον εδώ (το ιστορικό μένει)
  notes     String?
  address   PartyAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  person    Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  party     Party         @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, personId])
  @@index([personId])
}

// Τηλέφωνο ή email. Ανήκει είτε στην εταιρία (partyId, προαιρετικά σε υποκατάστημά της) είτε σε πρόσωπο (personId).
// Το κύριο τηλέφωνο και email της εταιρίας αντιγράφονται και στο Party.phone / Party.email (παραστατικά, αναζήτηση).
model PartyChannel {
  id        String        @id @default(cuid())
  partyId   String?
  personId  String?
  addressId String?
  kind      String // phone | email (lib/crm.ts)
  value     String
  label     String? // π.χ. «Κινητό», «Τιμολόγια», «Παραγγελίες»
  isPrimary Boolean       @default(false)
  party     Party?        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  person    Person?       @relation(fields: [personId], references: [id], onDelete: Cascade)
  address   PartyAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)

  @@index([partyId])
  @@index([personId])
  @@index([value])
}

// Ενέργεια CRM (όπως το SOACTION του SoftOne): σημείωση, κλήση, email, συνάντηση ή εργασία πάνω σε συναλλασσόμενο.
// Η τηλεφωνία, το ταχυδρομείο και η σάρωση παραστατικών θα γράφουν εδώ με source ≠ manual και externalId,
// ώστε το ίδιο γεγονός να μην καταχωρηθεί δύο φορές.
model PartyActivity {
  id          String    @id @default(cuid())
  orgId       String?
  partyId     String
  personId    String? // με ποιον έγινε
  kind        String // note | call | email | meeting | task
  direction   String? // in | out (κλήση, email)
  subject     String?
  body        String?
  at          DateTime  @default(now()) // πότε έγινε
  dueAt       DateTime? // εργασία: ως πότε
  doneAt      DateTime? // εργασία: πότε ολοκληρώθηκε
  durationMin Int?
  pinned      Boolean   @default(false)
  userId      String?
  userName    String
  source      String    @default("manual") // manual | telephony | mail | ocr
  externalId  String? // αναγνωριστικό στο εξωτερικό σύστημα
  refType     String? // με τι σχετίζεται: file, ticket, charge…
  refId       String?
  createdAt   DateTime  @default(now())
  party       Party     @relation(fields: [partyId], references: [id], onDelete: Cascade)
  person      Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)

  @@unique([source, externalId])
  @@index([partyId, at])
  @@index([orgId, doneAt, dueAt])
}

model PartyBankAccount {
  id        String  @id @default(cuid())
  partyId   String
  bank      String?
  iban      String // χωρίς κενά, κεφαλαία· ελέγχεται (mod 97) πριν αποθηκευτεί
  holder    String? // δικαιούχος, αν διαφέρει από την επωνυμία
  isPrimary Boolean @default(false)
  party     Party   @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@unique([partyId, iban])
}

// ---- Γεωγραφία: κοινές λίστες αναφοράς για όλους τους πελάτες (χωρίς orgId) ----
// Χώρες ISO 3166, δέντρο Καλλικράτη (Περιφέρεια → Νομός/Π.Ε. → Δήμος), πόλεις/οικισμοί και περιοχές.
// Πηγές και ανανέωση: prisma/geo/build.py (επίσημο κωδικολόγιο Καλλικράτη + GeoNames). Λογική: lib/geo.

model GeoCountry {
  code   String    @id // ISO 3166-1 alpha-2 («GR») — ίδιο με Party.countryCode, PartyAddress.countryCode κ.λπ.
  iso3   String? // alpha-3 («GRC»)
  nameEL String
  nameEN String
  isEu   Boolean   @default(false) // μέλος ΕΕ: το ΑΦΜ ελέγχεται στο VIES
  active Boolean   @default(true)
  cities GeoCity[]

  @@index([active, nameEL])
}

// Δέντρο Καλλικράτη, τρία επίπεδα: 3=Περιφέρεια («09»), 4=Περιφερειακή Ενότητα/νομός («0905»), 5=Δήμος («9205»).
// Οι κωδικοί είναι οι επίσημοι (ΕΕΤΑΑ)· οι κωδικοί Δήμων συμφωνούν με το GeoNames admin3, γι' αυτό και όλοι οι
// κόμβοι έχουν συντεταγμένες (κέντρο). Σχεδιασμός σύμφωνα με το Region του damask (level/parentCode/path).
model GeoRegion {
  code         String         @id
  level        Int
  nameEL       String // τονωμένο, για εμφάνιση («Δήμος Πεντέλης», «Νομός Δράμας»)
  nameOfficial String? // επίσημο κωδικολόγιο, κεφαλαία άτονα («ΠΕΝΤΕΛΗΣ») — αντιστοίχιση με ΑΑΔΕ/ΓΕΜΗ
  parentCode   String?
  parent       GeoRegion?     @relation("GeoTree", fields: [parentCode], references: [code], onDelete: SetNull)
  children     GeoRegion[]    @relation("GeoTree")
  path         String? // «09>0905>9205»: οι απόγονοι βρίσκονται με startsWith
  latitude     Float?
  longitude    Float?
  active       Boolean        @default(true)
  cities       GeoCity[]
  parties      Party[]
  addresses    PartyAddress[]
  stores       Store[]

  @@index([parentCode])
  @@index([level, active, nameEL])
  @@index([path])
}

// Πόλη/οικισμός: seed από GeoNames (id = geonameid) με τονωμένο όνομα και συντεταγμένες, δεμένη με τον Δήμο της.
// Όσες προκύψουν αργότερα από geocoding παίρνουν id «g-…» και όσες γραφτούν με το χέρι «m-…».
model GeoCity {
  id               String         @id
  name             String
  nameEn           String?
  countryCode      String         @default("GR")
  country          GeoCountry     @relation(fields: [countryCode], references: [code], onDelete: Restrict)
  municipalityCode String?
  municipality     GeoRegion?     @relation(fields: [municipalityCode], references: [code], onDelete: SetNull)
  latitude         Float?
  longitude        Float?
  population       Int            @default(0) // κατάταξη στις προτάσεις
  source           String         @default("geonames") // geonames | geocode | manual
  active           Boolean        @default(true)
  areas            GeoArea[]
  parties          Party[]
  addresses        PartyAddress[]
  stores           Store[]

  @@unique([countryCode, municipalityCode, name])
  @@index([name])
  @@index([municipalityCode, population])
}

// Περιοχή μέσα σε πόλη («Κολωνάκι»). Δεν υπάρχει επίσημη λίστα: μπαίνει από προτάσεις geocoding ή από τον
// χρήστη και μένει κοινή για όλους, ώστε η επόμενη φόρμα στην ίδια πόλη να την προτείνει.
model GeoArea {
  id         String         @id @default(cuid())
  cityId     String
  city       GeoCity        @relation(fields: [cityId], references: [id], onDelete: Cascade)
  name       String
  postalCode String?
  latitude   Float?
  longitude  Float?
  source     String         @default("manual") // geocode | manual
  parties    Party[]
  addresses  PartyAddress[]
  stores     Store[]

  @@unique([cityId, name])
}

// Συντελεστές ΦΠΑ, κοινοί για όλες τις επιχειρήσεις: τους ορίζει η πλατφόρμα,
// προϊόντα και υπηρεσίες διαλέγουν έναν από αυτούς.
model VatRate {
  id       String        @id @default(cuid())
  name     String        @unique // π.χ. «Κανονικός», «Μειωμένος», «Υπερμειωμένος»
  rate     Int // ποσοστό επί τοις εκατό, π.χ. 24 — ίδια κλίμακα με το αντίγραφο SaleLine.vatRate· μοναδικές τιμές τις εγγυάται η οθόνη πλατφόρμας
  active   Boolean       @default(true)
  products Product[]
  generics GenericItem[] // γενικά είδη με αυτόν τον συντελεστή (αγορές)

  @@index([active])
}

// ---- Προμήθειες (docs/analysis/PROCUREMENT-DESIGN.md): μονάδες, κεντρικός κατάλογος εμπορικών ειδών ----

// Μονάδα μέτρησης, κοινή για όλες τις επιχειρήσεις (seeded από migration — πηγή αλήθειας για μετατροπές).
// Η μετατροπή γίνεται μόνο μέσα στην ίδια διάσταση· η βασική μονάδα ανά διάσταση είναι mg / ml / τεμάχιο,
// και όλες οι ποσότητες αποθηκεύονται σε αυτήν ως ακέραιοι (όπως τα χρήματα σε λεπτά).
model Unit {
  id        String        @id @default(cuid())
  code      String        @unique // "kg", "g", "l", "ml", "pcs"…
  nameEL    String // «κιλό», «γραμμάριο», «τεμάχιο»…
  dimension String // mass | volume | count — αλλιώτικες διαστάσεις δεν μετατρέπονται μεταξύ τους
  toBase    Int // πόσες βασικές μονάδες είναι η μία· π.χ. g: 1000 (1 g = 1000 mg), kg: 1_000_000, pcs: 1
  active    Boolean       @default(true)
  items     TradeItem[]
  generics  GenericItem[] // γενικά είδη που μετριούνται σε αυτή τη μονάδα

  @@index([dimension, active])
}

// Κατασκευαστής/βιομηχανία (επίπεδο πλατφόρμας). Το brand μπορεί να είναι και ίδιο με τον κατασκευαστή.
// Η ταυτότητα από AI κρατά πηγές και δεν αντικαθιστά ποτέ αυτόματα χειροκίνητα website/logo.
model Manufacturer {
  id               String                        @id @default(cuid())
  name             String                        @unique // «ΦΑΓΕ», «ΔΕΛΤΑ»…
  website          String?
  logoUrl          String? // αποθηκευμένο αρχείο της πλατφόρμας ή χειροκίνητο HTTPS URL
  aliases          String[]                      @default([]) // παλαιές/εναλλακτικές γραφές που βοηθούν την αντιστοίχιση
  enrichmentStatus String                        @default("pending") // pending | enriched | review | error
  enrichmentSource Json? // μοντέλο, URLs τεκμηρίωσης και τυχόν σημειώσεις επαλήθευσης
  enrichedAt       DateTime?
  enrichmentError  String?
  brands           Brand[]
  ingredients      ManufacturerIngredient[]
  mergeSources     ManufacturerMergeSuggestion[] @relation("MergeSuggestionSource")
  mergeTargets     ManufacturerMergeSuggestion[] @relation("MergeSuggestionTarget")
  enrichmentRuns   CatalogEnrichmentRun[]
}

// Κανονικοποιημένη πρώτη ύλη, κοινή σε όλον τον κατάλογο — επιτρέπει ερωτήματα ανά υλικό και κατασκευαστή.
model RawIngredient {
  id             String                   @id @default(cuid())
  name           String
  normalizedName String                   @unique
  category       String // dairy | sugars | fats | eggs | chocolate | nuts | fruit | flour | starch | leavening | stabilizer | emulsifier | flavor | other
  manufacturers  ManufacturerIngredient[]
}

// Απόδειξη ότι ο κατασκευαστής διαθέτει/χρησιμοποιεί το υλικό, από συγκεκριμένα προϊόντα του καταλόγου.
model ManufacturerIngredient {
  manufacturerId String
  ingredientId   String
  isCore         Boolean       @default(false)
  pastryRelevant Boolean       @default(false)
  evidence       String? // αυτούσιο απόσπασμα ετικέτας ή ονόματος προϊόντος
  productIds     String[]      @default([])
  source         String        @default("ai") // ai | manual
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  manufacturer   Manufacturer  @relation(fields: [manufacturerId], references: [id], onDelete: Cascade)
  ingredient     RawIngredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([manufacturerId, ingredientId])
  @@index([ingredientId, pastryRelevant])
}

// Πρόταση ταυτοποίησης από AI· η συγχώνευση γίνεται μόνο με ανθρώπινη επιβεβαίωση.
model ManufacturerMergeSuggestion {
  sourceId   String
  targetId   String
  confidence Int // 0–100
  reason     String?
  createdAt  DateTime     @default(now())
  source     Manufacturer @relation("MergeSuggestionSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target     Manufacturer @relation("MergeSuggestionTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
  @@index([targetId])
}

// Κόστος και αποτέλεσμα κάθε κλήσης, κοινό μηνιαίο ταβάνι με τον agent υποστήριξης.
model CatalogEnrichmentRun {
  id               String        @id @default(cuid())
  manufacturerId   String? // μένει το audit κόστους ακόμα κι αν διαγραφεί ο κατασκευαστής
  model            String
  status           String // enriched | review | error
  promptTokens     Int           @default(0)
  completionTokens Int           @default(0)
  costUsd          Float         @default(0)
  error            String?
  createdAt        DateTime      @default(now())
  manufacturer     Manufacturer? @relation(fields: [manufacturerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([manufacturerId, createdAt])
}

model Brand {
  id             String       @id @default(cuid())
  manufacturerId String
  name           String // «ΤΩΝ 150», «ΑΓΓΕΛΑΚΗΣ»…
  manufacturer   Manufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  items          TradeItem[]

  @@unique([manufacturerId, name])
}

// Κατηγορία κεντρικού καταλόγου ειδών (δέντρο: «Γαλακτοκομικά» → «Γάλατα»). Κοινή για όλους — την ορίζει η πλατφόρμα.
model TradeCategory {
  id       String          @id @default(cuid())
  parentId String?
  name     String
  position Int             @default(0)
  active   Boolean         @default(true)
  parent   TradeCategory?  @relation("TradeCatTree", fields: [parentId], references: [id], onDelete: Restrict)
  children TradeCategory[] @relation("TradeCatTree")
  items    TradeItem[]

  @@unique([parentId, name])
}

// Συσκευασμένο είδος εμπορίου. orgId κενό = κεντρικός κατάλογος της πλατφόρμας (οι συνδρομητές δεν τα
// ξανακαταχωρούν)· orgId συμπληρωμένο = «ιδιωτικό» είδος συνδρομητή (π.χ. χύμα από μικρό παραγωγό).
// Η συσκευασία ΔΕΝ είναι μονάδα: το περιεχόμενο δηλώνεται σε βασική μονάδα (contentQty/contentUnit).
model TradeItem {
  id            String         @id @default(cuid())
  orgId         String?
  categoryId    String?
  brandId       String?
  ean           String? // EAN-13/GTIN· στον κεντρικό κατάλογο μοναδικό (partial index στο migration)
  name          String // «Γάλα φρέσκο 1,5% 1L»
  packaging     String? // περιγραφή συσκευασίας: «χαρτοκιβώτιο», «πλαστικό μπουκάλι»…
  contentQty    Int // περιεχόμενο σε βασική μονάδα: 1 L → 1000 (ml), 25 kg → 25_000_000 (mg)
  contentUnitId String // η μονάδα κατανάλωσης του περιεχομένου
  familyCode    String? // ομαδοποίηση ποικιλιών συσκευασίας ίδιου είδους («DELTA-GA-1.5»: 1L, 1,5L…)
  imageUrl      String? // φωτογραφία: διαδρομή στο Bunny («catalog/off/<ean>.jpg») ή πλήρες CDN URL
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  org           Organization?  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category      TradeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand         Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  contentUnit   Unit           @relation(fields: [contentUnitId], references: [id], onDelete: Restrict)
  composition   Composition?
  mappings      ItemMapping[]
  supplierItems SupplierItem[]
  purchaseLines PurchaseLine[]

  @@unique([orgId, ean])
  @@index([orgId, name])
  @@index([categoryId])
}

// Γενικό είδος του συνδρομητή («γάλα φρέσκο», «ζάχαρη άχνη») — αυτό που μπαίνει στις συνταγές.
// Η βασική του μονάδα είναι η μονάδα κατανάλωσης· οι ποσότητες κρατιούνται πάντα σε αυτήν (Int, βλ. Unit).
// Φύση γραμμής στο myDATA (ψηφίο S του ftChargeItemCase της Viva): από αυτήν βγαίνει ο χαρακτηρισμός εσόδου
enum ItemNature {
  GOODS // εμπόρευμα για μεταπώληση → category1_1
  PRODUCT // προϊόν δικής παραγωγής → category1_2
  SERVICE // υπηρεσία → category1_3
}

model GenericItem {
  id                String                @id @default(cuid())
  orgId             String
  name              String
  nature            ItemNature            @default(GOODS)
  baseUnitId        String
  vatRateId         String? // συντελεστής ΦΠΑ αγοράς (προεπιλογή στις αγορές/συμφωνίες)
  // Μέσο σταθμισμένο κόστος σε εκατοστά λεπτού ανά kg/l ή 1.000 τεμάχια — γράφεται στην αποδοχή τιμολογίου
  avgCostHundredths Int                   @default(0)
  trackStock        Boolean               @default(true) // false = κοστολογείται χωρίς απόθεμα (π.χ. νερό βρύσης)
  gramsPerPiece     Int? // για είδη σε τεμάχια: βάρος τεμαχίου σε g (π.χ. αυγό 55)
  active            Boolean               @default(true)
  createdAt         DateTime              @default(now())
  org               Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  baseUnit          Unit                  @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  vatRate           VatRate?              @relation(fields: [vatRateId], references: [id], onDelete: SetNull)
  composition       Composition?
  mappings          ItemMapping[]
  lots              StockLot[]
  purchaseLines     PurchaseLine[]
  recipeItems       RecipeItem[]
  productionItems   ProductionBatchItem[]
  transferLines     StockTransferLine[]
  countLines        StockCountLine[]
  stockThresholds   StockThreshold[]
  spots             ItemSpot[]

  @@unique([orgId, name])
  @@index([orgId, active])
}

// Αντιστοίχιση γενικού είδους ↔ εμπορικού είδους: «το γάλα μου είναι αυτή η συσκευασία».
// Ένα εμπορικό είδος αντιστοιχεί σε ΤΟ ΠΟΛΥ ένα γενικό ανά επιχείρηση (το αντίστροφο επιτρέπεται:
// πολλά εμπορικά — διαφορετικές συσκευασίες/προμηθευτές — τροφοδοτούν το ίδιο γενικό).
model ItemMapping {
  id            String       @id @default(cuid())
  orgId         String
  genericItemId String
  tradeItemId   String
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  genericItem   GenericItem  @relation(fields: [genericItemId], references: [id], onDelete: Cascade)
  tradeItem     TradeItem    @relation(fields: [tradeItemId], references: [id], onDelete: Cascade)

  @@unique([orgId, tradeItemId])
  @@index([orgId, genericItemId])
}

// Είδος προμηθευτή: πώς πουλά ο συγκεκριμένος προμηθευτής ένα εμπορικό είδος — δικός του κωδικός,
// barcode συσκευασίας/κιβωτίου και πολλαπλότητα συσκευασίας. Πολλοί προμηθευτές μπορεί να πουλάνε
// το ίδιο TradeItem· ο κωδικός προμηθευτή (όταν υπάρχει) είναι μοναδικός ανά προμηθευτή.
model SupplierItem {
  id            String              @id @default(cuid())
  orgId         String
  supplierId    String
  tradeItemId   String
  supplierCode  String? // ο κωδικός είδους στον τιμοκατάλογο/τιμολόγιο του προμηθευτή
  barcode       String? // EAN/GTIN όπως το σαρώνει ο χρήστης (μπορεί να είναι κιβωτίου, όχι της μονάδας)
  packQty       Int                 @default(1) // πόσες συσκευασίες TradeItem έχει η μονάδα παραγγελίας του προμηθευτή
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  org           Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  supplier      Party               @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  tradeItem     TradeItem           @relation(fields: [tradeItemId], references: [id], onDelete: Restrict)
  prices        SupplierItemPrice[]
  purchaseLines PurchaseLine[]

  @@unique([orgId, supplierId, supplierCode])
  @@index([orgId, tradeItemId])
  @@index([orgId, barcode])
}

// Γεγονός χρήσης επί πληρωμή υπηρεσίας (pay-as-you-go): OCR τιμολογίων σήμερα, αύριο SMS/χάρτες κ.λπ.
// Η χρέωση του συνδρομητή βγαίνει από costUsd × ισοτιμία × (1 + markup του UsagePrice) — βλ. lib/usage.ts.
model UsageEvent {
  id            String       @id @default(cuid())
  orgId         String
  service       String // κλειδί υπηρεσίας: «ocr», μελλοντικά «sms», «maps»…
  units         Int          @default(1) // πόσες μονάδες καταναλώθηκαν (π.χ. έγγραφα)
  costUsd       Float        @default(0) // το κόστος που χρεώθηκε η πλατφόρμα στον πάροχο
  chargeCents   Int          @default(0) // η χρέωση του συνδρομητή σε λεπτά EUR (με το markup)
  detail        Json? // μοντέλο, tokens, purchaseDocId, ok/error — ανά υπηρεσία
  createdByName String
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, service, createdAt])
}

// Τιμολογιακή πολιτική μιας pay-as-you-go υπηρεσίας — την ορίζει ο κεντρικός διαχειριστής (μία γραμμή ανά service).
// Το markup εφαρμόζεται πάνω στο πραγματικό κόστος του παρόχου· ανενεργή υπηρεσία = δεν επιτρέπεται η χρήση.
model UsagePrice {
  service       String  @id // «ocr»
  label         String // «Ανάγνωση τιμολογίου (OCR)»
  unitLabel     String // «ανά έγγραφο» — πώς μετράει η χρέωση
  markupPercent Int     @default(30)
  active        Boolean @default(true)
}

// Τιμή αγοράς με όρους. Η «κανονική» τιμή είναι η γραμμή χωρίς όρους·
// η ειδική συμφωνία είναι γραμμή με minPackQty ή/και διάστημα ισχύος.
// Μόνο προσθήκες (ιστορικό)· η τρέχουσα είναι η πιο «συγκεκριμένη» που ισχύει (lib/pricing.ts).
model SupplierItemPrice {
  id             String       @id @default(cuid())
  supplierItemId String
  priceCents     Int // τιμή ανά συσκευασία TradeItem (όχι ανά μονάδα παραγγελίας), πάντα προ ΦΠΑ, σε λεπτά
  minPackQty     Int? // ελάχιστη ποσότητα συσκευασιών παραγγελίας για να ισχύσει
  validFrom      DateTime     @default(now())
  validTo        DateTime?
  note           String? // «Συμφωνία έκθεσης 2026», «προσφορά Νοεμβρίου»
  createdByName  String
  createdAt      DateTime     @default(now())
  supplierItem   SupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Cascade)

  @@index([supplierItemId, validFrom])
}

// Νομίσματα ISO 4217, κοινά για όλη την πλατφόρμα. Το σύμβολο χρησιμοποιείται
// σε φόρμες και εκτυπώσεις· ο κωδικός μένει σταθερός για μελλοντικές αναφορές παραστατικών.
model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // ISO 4217 alpha-3: EUR, USD, GBP…
  name      String // ελληνική ονομασία
  symbol    String // €, $, £, CHF…
  active    Boolean  @default(true)
  sort      Int      @default(100)
  createdAt DateTime @default(now())

  @@index([active, sort, code])
}

// Τρόποι πληρωμής, κοινοί για όλη την πλατφόρμα (χωρίς orgId). Προεπιλογή: όσοι υποστηρίζει η Viva·
// ο κεντρικός διαχειριστής προσθέτει και άλλους. Τα system είναι seeded και δεν διαγράφονται·
// κλειδωμένα code και αντιστοιχίσεις, αλλάζει μόνο το active και η εμφάνιση στο ταμείο.
model PaymentMethod {
  id            String          @id @default(cuid())
  code          String          @unique // σταθερό κλειδί: "cash", "card", "iris"… — δεν αλλάζει ποτέ
  name          String // η ετικέτα που βλέπει ο χρήστης
  provider      PaymentProvider
  // Αντιστοιχίσεις της Viva: MethodId του Smart Checkout (preselect) και paymentMethod των terminal APIs
  vivaMethodId  Int?
  vivaPosMethod String?
  // Φορολογική αντιστοίχιση: το τελευταίο byte του ftPayItemCase (0x01 μετρητά, 0x05 κάρτα· βλ. lib/viva/fiscal).
  // Κενό = ο τρόπος δεν εκδίδει απόδειξη λιανικής (π.χ. B2B πληρωμή)· τέτοιος δεν μπαίνει στο ταμείο.
  payItemCase   Int?
  myDataCode    Int? // τρόπος πληρωμής myDATA 1–7, για B2B παραστατικά και αναφορές
  ledgerKind    PaymentLedger // πού «πέφτει» το ποσό λογιστικά
  // Συμπεριφορά στο ταμείο
  posEnabled    Boolean         @default(false)
  givesChange   Boolean         @default(false) // επιτρέπει ρέστα (μόνο μετρητά)
  system        Boolean         @default(false)
  active        Boolean         @default(true)
  sort          Int             @default(0)
  payments      Payment[]
  billShares    BillShare[]
  parties       Party[]

  @@index([active, posEnabled, sort])
}

// Λίστες αναφοράς, κοινές για όλους: ΔΟΥ, όροι πληρωμής, μονάδες μέτρησης.
// (Χώρες και γεωγραφία ζουν στα Geo* μοντέλα παραπάνω· οι συντελεστές ΦΠΑ στο VatRate,
// τα νομίσματα στο Currency και οι τρόποι πληρωμής στο PaymentMethod.)
// Τις ορίζει μία φορά η πλατφόρμα· οι επιχειρήσεις διαλέγουν από αυτές.
model RefItem {
  id     String  @id @default(cuid())
  list   String // taxOffice, paymentTerm, unit
  code   String
  label  String
  value  Int? // αριθμητική τιμή όπου έχει νόημα: ημέρες πίστωσης
  sort   Int     @default(0)
  active Boolean @default(true)

  @@unique([list, code])
  @@index([list, active, sort])
}

// Ρύθμιση σύνδεσης της πλατφόρμας ως κλειδί → τιμή (βλ. lib/config.ts για τα κλειδιά). Περιέχει και μυστικά κλειδιά:
// δεν επιστρέφονται ποτέ στον browser.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Κάθε φορά που κάποιος από την υποστήριξη ανοίγει απομακρυσμένη σύνδεση σε συσκευή πελάτη: ποιος, πότε, γιατί.
// Ο πελάτης το βλέπει στις Συσκευές του. Μόνο προσθήκες.
model RemoteAccess {
  id            String   @id @default(cuid())
  orgId         String
  deviceId      String
  startedById   String?
  startedByName String
  reason        String
  at            DateTime @default(now())
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([orgId, at])
}

// ---- Support desk: αιτήματα των πελατών προς την υποστήριξη (docs/analysis/SUPPORT-DESK.md) ----
enum TicketStatus {
  NEW // δεν έχει απαντηθεί ακόμα
  OPEN // σε εξέλιξη: περιμένει την υποστήριξη
  WAITING_CUSTOMER // απαντήθηκε: περιμένει τον πελάτη
  RESOLVED // λύθηκε· κλείνει μόνο του μετά από 5 ημέρες χωρίς απάντηση
  CLOSED
}

enum TicketPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

model Ticket {
  id              String          @id @default(cuid())
  number          Int             @unique @default(autoincrement()) // ο αριθμός που βλέπουν όλοι: #1042
  orgId           String
  subject         String
  category        String // κλειδί του CATEGORIES (lib/support/rules.ts)
  priority        TicketPriority
  status          TicketStatus    @default(NEW)
  deviceId        String? // η συσκευή που αφορά, αν αφορά κάποια
  openedById      String?
  openedByName    String
  assigneeId      String?
  assigneeName    String?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  rating          Int? // 1–5, από τον πελάτη όταν λυθεί
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  org             Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]

  @@index([orgId, status])
  @@index([status, priority, createdAt])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorKind String // customer | support | system
  authorId   String?
  authorName String
  body       String
  internal   Boolean  @default(false) // εσωτερική σημείωση: ο πελάτης δεν τη βλέπει
  createdAt  DateTime @default(now())
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

// ---- Βάση γνώσεων: άρθρα για τους πελάτες (δημόσια) και για την υποστήριξη (εσωτερικά) ----
enum KbStatus {
  DRAFT // πρόχειρο
  REVIEW // προς έγκριση
  PUBLISHED
  RETIRED // αποσυρμένο: δεν φαίνεται πουθενά, αλλά δεν σβήνεται
}

model KbArticle {
  id             String      @id @default(cuid())
  title          String
  body           String // απλό κείμενο: παράγραφοι, «- » για λίστα, «1. » για βήματα, «## » για υπότιτλο
  category       String // κλειδί του CATEGORIES (lib/support/rules.ts)
  internal       Boolean     @default(false) // true = μόνο για την υποστήριξη
  status         KbStatus    @default(DRAFT)
  sourceTicketId String? // το αίτημα από το οποίο προέκυψε, αν προέκυψε από αίτημα
  authorName     String
  updatedByName  String?
  publishedAt    DateTime?
  views          Int         @default(0)
  helpfulYes     Int         @default(0)
  helpfulNo      Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  versions       KbVersion[]

  @@index([status, internal])
}

// Η προηγούμενη μορφή ενός άρθρου, κάθε φορά που αλλάζει τίτλος ή κείμενο.
model KbVersion {
  id          String    @id @default(cuid())
  articleId   String
  title       String
  body        String
  savedByName String
  createdAt   DateTime  @default(now())
  article     KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, createdAt])
}

// ---- Μνήμη του agent (RAG). Κάθε κομμάτι κειμένου έχει το διάνυσμά του (pgvector) για αναζήτηση με νόημα.
// orgId = null → κοινή γνώση (άρθρα)· orgId = πελάτης → ανακτάται ΜΟΝΟ σε αιτήματα του ίδιου πελάτη (λυμένα αιτήματά του).
model KbChunk {
  id         String                 @id @default(cuid())
  sourceType String // article | ticket
  sourceId   String
  orgId      String?
  internal   Boolean                @default(false) // εσωτερικό άρθρο: μόνο όταν ο agent βοηθά υπάλληλο
  title      String
  content    String
  model      String // το μοντέλο embeddings που έβγαλε το διάνυσμα· η αναζήτηση συγκρίνει μόνο ίδια μοντέλα
  embedding  Unsupported("vector")?
  createdAt  DateTime               @default(now())

  @@index([sourceType, sourceId])
  @@index([orgId])
}

// Κάθε εκτέλεση του agent: τι του δόθηκε, τι απάντησε, πόσο κόστισε και τι έκανε ο υπάλληλος με το προσχέδιο.
model AgentRun {
  id               String   @id @default(cuid())
  ticketId         String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  costUsd          Float    @default(0)
  sources          Json // τα κομμάτια μνήμης που ανακτήθηκαν
  facts            Json // τα διαγνωστικά της επιχείρησης που του δόθηκαν
  reply            String
  note             String? // εσωτερική παρατήρηση του agent για τον υπάλληλο
  confidence       String // high | medium | low
  outcome          String? // sent | edited | rejected· κενό = δεν αποφασίστηκε ακόμα
  createdByName    String
  createdAt        DateTime @default(now())

  @@index([ticketId, createdAt])
  @@index([createdAt])
}

// Ιστορικό πρόσβασης: ποιος άλλαξε χρήστη, ρόλο ή δικαίωμα και πότε. Μόνο προσθήκες, ποτέ αλλαγή.
model AccessEvent {
  id        String   @id @default(cuid())
  orgId     String? // κενό = προσωπικό της πλατφόρμας
  actorName String
  action    String // κλειδί από lib/access.ts
  target    String // όνομα χρήστη ή ρόλου τη στιγμή της αλλαγής
  detail    String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}

// Ρόλος προσωπικού της πλατφόρμας φτιαγμένος από την οθόνη: όνομα + δικαιώματα (κλειδιά PLATFORM_PERMISSIONS).
model StaffRole {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions String[]
  createdAt   DateTime @default(now())
  users       User[]
}

// Ομάδα προσωπικού πλατφόρμας: προσθετικά δικαιώματα κονσόλας πάνω στον ρόλο (ένωση, ποτέ αφαίρεση).
model StaffGroup {
  id          String             @id @default(cuid())
  name        String             @unique
  permissions String[]
  createdAt   DateTime           @default(now())
  members     StaffGroupMember[]
}

model StaffGroupMember {
  userId  String
  groupId String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   StaffGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
}

// Πρόσβαση υπαλλήλου της πλατφόρμας σε δεδομένα συνδρομητή: σε ολόκληρη την επιχείρηση (storeId κενό)
// ή σε ένα κατάστημά της, με δικαιώματα της πλευράς της επιχείρησης (area.action του καταλόγου συνδρομητή).
model StaffStoreAccess {
  id          String       @id @default(cuid())
  userId      String
  orgId       String
  storeId     String? // κενό = όλα τα καταστήματα της επιχείρησης
  permissions String[]
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store       Store?       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([userId, orgId])
}

// Πακέτο συνδρομής: ποιες ενότητες ανοίγει και πόσο κοστίζει κάθε κατάστημα και κάθε είδος συσκευής (λεπτά, προ ΦΠΑ, τον μήνα).
model Plan {
  id                  String         @id @default(cuid())
  name                String         @unique
  description         String?
  active              Boolean        @default(true) // ανενεργό: δεν δίνεται σε νέους πελάτες, όσοι το έχουν το κρατούν
  isDefault           Boolean        @default(false)
  modules             String[] // κλειδιά από lib/modules.ts
  storeCents          Int
  devicePrices        Json // { POS_WEB: 1500, FRIDGE: 0, … } ανά DeviceKind
  // Εποχιακή παύση καταστήματος
  pausePercent        Int            @default(30) // τι ποσοστό της τιμής πληρώνει το κατάστημα όσο είναι σε παύση
  pausedModules       String[] // ενότητες που μένουν ανοιχτές στην παύση
  pauseMaxDaysPerYear Int            @default(240)
  createdAt           DateTime       @default(now())
  subscriptions       Subscription[]
}

// Περίοδος παύσης ενός καταστήματος (εποχιακό). Η έκπτωση δίνεται μόνο αν κρατήσει 30+ ημέρες.
model StorePause {
  id             String    @id @default(cuid())
  orgId          String
  storeId        String
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  maxDays        Int // πόσες ημέρες έκπτωσης δικαιούται αυτή η παύση (όριο πακέτου μείον όσες χρησιμοποιήθηκαν το τελευταίο 12μηνο)
  settledThrough DateTime? // ως ποια ημέρα έχει ήδη δοθεί η έκπτωση σε χρέωση
  startedByName  String
  endedByName    String?
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, startedAt])
  @@index([orgId])
}

// Ιστορικό ελέγχων ξένων ΑΦΜ (VIES κ.ά.). Ο αριθμός ελέγχου είναι το αποδεικτικό για ενδοκοινοτικές συναλλαγές·
// ένας έγκυρος έλεγχος ξαναχρησιμοποιείται για 30 ημέρες (lib/party-lookup.ts).
model VatCheck {
  id                 String   @id @default(cuid())
  orgId              String? // ποια επιχείρηση ρώτησε· κενό = η πλατφόρμα
  vat                String
  countryCode        String
  valid              Boolean?
  name               String?
  address            String?
  provider           String?
  source             String?
  consultationNumber String?
  requester          String?
  match              Json?
  error              String?
  message            String?
  createdByName      String?
  createdAt          DateTime @default(now())

  @@index([vat, createdAt])
  @@index([orgId, createdAt])
}

// Τεχνική σύσταση είδους ανά 100 g, για την ανάλυση συνταγών (lib/recipe-analysis.ts).
// Στον κεντρικό κατάλογο κρέμεται στο TradeItem (orgId = null, τη συντηρεί η πλατφόρμα)·
// για «ιδιωτικό» είδος χωρίς TradeItem, στο GenericItem του συνδρομητή. Ακριβώς ένα από τα δύο.
// Όλα τα ποσοστά σε χιλιοστά της εκατοστιαίας μονάδας (3,5% → 3500) — Int, όπως τα λεπτά στα χρήματα.
model Composition {
  id                    String        @id @default(cuid())
  orgId                 String? // null = κεντρικός κατάλογος
  tradeItemId           String?       @unique
  genericItemId         String?       @unique
  fatPm                 Int? // λιπαρά
  msnfPm                Int? // στερεά γάλακτος άνευ λίπους
  sucrosePm             Int?
  dextrosePm            Int?
  glucoseSyrupPm        Int?
  glucoseDe             Int? // δεξτροζοϊσοδύναμο του σιροπιού γλυκόζης (ακέραιος, π.χ. 38)
  invertSugarPm         Int?
  fructosePm            Int?
  lactosePm             Int? // ρητή λακτόζη· αλλιώς εκτίμηση από MSNF (βλ. materialLactose)
  cocoaNonfatPm         Int? // απολιπασμένο κακάο
  stabilizerPm          Int?
  emulsifierPm          Int?
  saltPm                Int?
  alcoholPm             Int? // αλκοολικός τίτλος ετικέτας (% vol)
  otherSolidsPm         Int?
  proteinAvailablePm    Int? // διαθέσιμες πρωτεΐνες γάλακτος
  otherProteinPm        Int? // άλλες πρωτεΐνες (αυγό, ξηροί καρποί, φυτικές)
  fiberPm               Int?
  pacOverridePm         Int? // χειροκίνητο PAC ανά 100 g — υπερισχύει του υπολογισμού
  podOverridePm         Int? // χειροκίνητο POD ανά 100 g
  totalSolidsOverridePm Int? // χειροκίνητα ολικά στερεά
  acidityLevel          String? // none | high | very_high (οδηγεί τον AFP)
  containsStarch        Boolean       @default(false)
  containsCocoa         Boolean       @default(false)
  allergensContains     String[]      @default([]) // περιέχει αλλεργιογόνα (κλειδιά καταλόγου)
  allergensTraces       String[]      @default([]) // ίχνη
  ingredientsText       String? // συστατικά όπως στην ετικέτα (π.χ. από Open Food Facts)
  isVegan               Boolean       @default(false)
  isVegetarian          Boolean       @default(true)
  isSugarFree           Boolean       @default(false)
  isGlutenFree          Boolean       @default(true)
  isLactoseFree         Boolean       @default(true)
  containsAlcohol       Boolean       @default(false)
  updatedAt             DateTime      @updatedAt
  org                   Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tradeItem             TradeItem?    @relation(fields: [tradeItemId], references: [id], onDelete: Cascade)
  genericItem           GenericItem?  @relation(fields: [genericItemId], references: [id], onDelete: Cascade)
}

// Συνταγή παγωτού του συνδρομητή (βάση/γεύση). Οι γραμμές είναι πάντα σε γραμμάρια.
model Recipe {
  id                  String            @id @default(cuid())
  orgId               String
  name                String
  type                String            @default("cream") // κλειδί των RECIPE_TYPES (lib/recipe-analysis.ts)
  batchGrams          Int               @default(5000) // τυπικό μέγεθος δόσης για κοστολόγηση/παραγωγή
  productId           String? // το προϊόν βιτρίνας που πουλάει η γεύση — κλείνει το «ένα βήμα μπροστά» της ιχνηλασιμότητας
  outputGenericItemId String? // το απόθεμα ημιέτοιμου/έτοιμου που παράγει η συνταγή
  shelfLifeDays       Int?
  notes               String?
  active              Boolean           @default(true)
  createdAt           DateTime          @default(now())
  org                 Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product             Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  items               RecipeItem[]
  productionBatches   ProductionBatch[]

  @@unique([orgId, name])
  @@index([orgId, productId])
}

model RecipeItem {
  id            String       @id @default(cuid())
  orgId         String
  recipeId      String
  genericItemId String
  grams         Int // ποσότητα σε γραμμάρια — η μετατροπή σε βασική μονάδα γίνεται στην παραγωγή
  sortOrder     Int          @default(0)
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recipe        Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  genericItem   GenericItem  @relation(fields: [genericItemId], references: [id], onDelete: Restrict)

  @@index([recipeId])
  @@index([orgId, genericItemId])
}

// Παρτίδα παραγωγής: μία δόση συνταγής που κλείνει ΑΤΟΜΙΚΑ (μία συναλλαγή) — FEFO κατανάλωση
// υλικών από StockLot (αρνητικές κινήσεις με lotId) και ιχνηλασιμότητα: ποια παρτίδα υλικού μπήκε.
model ProductionBatch {
  id                     String                @id @default(cuid())
  orgId                  String
  recipeId               String
  warehouseId            String // από ποια αποθήκη τράβηξε τα υλικά
  batchNumber            String // αριθμός παρτίδας του παραγόμενου: YYYYMMDD-N
  quantityGrams          Int // παράχθηκε (g)
  costHundredths         Int                   @default(0) // συνολικό κόστος δόσης σε εκατοστά λεπτού
  recipeVersionId        String?
  recipeSnapshot         Json?
  destinationWarehouseId String?
  outputGenericItemId    String?
  outputLotId            String?
  expectedQuantityGrams  Int?
  wasteGrams             Int                   @default(0)
  scrapReason            String?
  labourMinutes          Int                   @default(0)
  labourCostCents        Int                   @default(0)
  note                   String?
  producedAt             DateTime              @default(now())
  createdByName          String?
  createdAt              DateTime              @default(now())
  org                    Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  recipe                 Recipe                @relation(fields: [recipeId], references: [id], onDelete: Restrict)
  warehouse              Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items                  ProductionBatchItem[]

  @@unique([orgId, batchNumber])
  @@index([orgId, producedAt])
}

// Γραμμή παραγωγής: πόσο καταναλώθηκε από ποιο είδος και από ποια παρτίδα του (FEFO).
// lotId κενό μόνο για είδη trackStock=false (κοστολογούνται χωρίς απόθεμα).
model ProductionBatchItem {
  id             String          @id @default(cuid())
  orgId          String
  batchId        String
  genericItemId  String
  grams          Int // η αναλογούσα ποσότητα της συνταγής (g)
  quantity       Int // κατανάλωση σε βασικές μονάδες (mg/ml/τεμ)
  lotId          String?
  costHundredths Int             @default(0)
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch          ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  genericItem    GenericItem     @relation(fields: [genericItemId], references: [id], onDelete: Restrict)
  lot            StockLot?       @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([batchId])
  @@index([orgId, genericItemId])
}

enum HaccpRecordStatus {
  DRAFT
  COMPLETED
}

enum HaccpRecordResult {
  CONFORMING
  DEVIATION
  NA
}

// Κοινή τεκμηρίωση για όλα τα έντυπα· το σχέδιο/τα όρια παραμένουν ευθύνη του tenant.
model HaccpRecord {
  id               String            @id @default(cuid())
  orgId            String
  storeId          String?
  templateId       String
  occurredAt       DateTime
  status           HaccpRecordStatus @default(DRAFT)
  result           HaccpRecordResult @default(CONFORMING)
  measuredValue    Float?
  unit             String?
  responsibleName  String
  notes            String?
  correctiveAction String?
  createdById      String
  createdByName    String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  org              Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store            Store?            @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([orgId, templateId, occurredAt])
  @@index([orgId, storeId, occurredAt])
  @@index([orgId, status, result])
}

// Ιστορικό στιγμιότυπων· findings JSON για αναπαραγώγιμη αναφορά χωρίς απώλεια παλιών συμπερασμάτων.
model HaccpAssessment {
  id          String       @id @default(cuid())
  orgId       String
  score       Int
  critical    Int
  warnings    Int
  findings    Json
  evaluatedAt DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, evaluatedAt])
}

// Καθολικός έλεγχος URL/περιεχομένου· δεν περιέχει δεδομένα tenant.
model HaccpSourceCheck {
  sourceId    String    @id
  url         String
  finalUrl    String?
  fingerprint String?
  status      String // OK | CHANGED | REVIEW | ERROR
  httpStatus  Int?
  message     String?
  checkedAt   DateTime
  changedAt   DateTime?

  @@index([status, checkedAt])
}

// ---- Επιχειρησιακές ροές: κάθε εγγραφή ανήκει ρητά σε Organization και ελέγχεται server-side. ----

model PurchaseOrder {
  id                   String              @id @default(cuid())
  orgId                String
  supplierId           String
  warehouseId          String
  number               String
  status               PurchaseOrderStatus @default(DRAFT)
  expectedAt           DateTime?
  note                 String?
  sentAt               DateTime?
  sentVia              String?
  netCents             Int                 @default(0)
  vatCents             Int                 @default(0)
  totalCents           Int                 @default(0)
  // Τιμολόγιο για όλη την παραγγελία πριν έρθουν τα είδη (προπληρωμή): μόνο οικονομικό, το απόθεμα το γράφουν τα δελτία
  invoiceDocId         String?             @unique
  creditRequestedCents Int                 @default(0) // αξία ειδών που κλείσαμε με αίτημα πιστωτικού (το 5.1 «Μόνο αξία» στο τιμολόγιο την καλύπτει)
  createdByName        String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  org                  Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  invoiceDoc           PurchaseDoc?        @relation("PurchaseOrderInvoice", fields: [invoiceDocId], references: [id], onDelete: Restrict)
  lines                PurchaseOrderLine[]
  receipts             PurchaseReceipt[]

  @@unique([orgId, number])
  @@index([orgId, supplierId, status, expectedAt])
  @@index([orgId, warehouseId, status])
}

model PurchaseOrderLine {
  id              String                     @id @default(cuid())
  orgId           String
  orderId         String
  genericItemId   String
  supplierItemId  String?
  orderedBaseQty  Int
  receivedBaseQty Int                        @default(0)
  closedBaseQty   Int                        @default(0) // όσα δεν θα έρθουν: κλεισμένα με αίτημα πιστωτικού ή χωρίς αυτά
  expectedAt      DateTime? // αναμενόμενα (back order): πότε υποσχέθηκε ο προμηθευτής τα υπόλοιπα
  packQty         Int                        @default(1)
  unitPriceCents  Int
  discountBps     Int                        @default(0)
  vatRate         Int                        @default(0)
  note            String?
  order           PurchaseOrder              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceMatches  PurchaseInvoiceLineMatch[]

  @@unique([orderId, genericItemId])
  @@index([orgId, genericItemId, orderId])
}

model PurchaseReceipt {
  id                    String                       @id @default(cuid())
  orgId                 String
  orderId               String
  purchaseDocId         String                       @unique
  invoiceDocId          String?                      @unique // το πολύ ένα χρηματοοικονομικό τιμολόγιο ανά παραλαβή
  clientKey             String
  requestHash           String
  deliveryNoteNumber    String? // το δελτίο αποστολής του προμηθευτή που συνόδευε τα είδη
  deliveryNoteDate      DateTime?
  deliveryNoteMark      String?
  reviewStatus          String                       @default("PROVISIONAL") // PROVISIONAL | REVIEWED — ρητός έλεγχος πριν από τιμολόγιο
  reviewedAt            DateTime?
  reviewedByName        String?
  reviewNote            String?
  invoiceRequestHash    String?
  invoiceMatchStatus    String                       @default("PENDING") // PENDING | MATCHED | DISCREPANCY | REVIEWED
  invoiceReviewedAt     DateTime?
  invoiceReviewedByName String?
  invoiceReviewNote     String?
  reversedAt            DateTime?
  reversalReason        String?
  createdByName         String
  createdAt             DateTime                     @default(now())
  org                   Organization                 @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order                 PurchaseOrder                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceDoc            PurchaseDoc?                 @relation("PurchaseReceiptInvoice", fields: [invoiceDocId], references: [id], onDelete: Restrict)
  lines                 PurchaseReceiptLine[]
  discrepancies         PurchaseReceiptDiscrepancy[]
  invoiceMatches        PurchaseInvoiceLineMatch[]
  invoiceDiscrepancies  PurchaseInvoiceDiscrepancy[]

  @@unique([orgId, clientKey])
  @@index([orgId, orderId, createdAt])
  @@index([orgId, reviewStatus, createdAt])
  @@index([orgId, invoiceMatchStatus, createdAt])
}

model PurchaseReceiptLine {
  id                         String                      @id @default(cuid())
  orgId                      String
  receiptId                  String
  orderLineId                String
  purchaseLineId             String                      @unique
  genericItemId              String
  lotId                      String?
  quantityBase               Int
  previousAvgCostHundredths  Int
  resultingAvgCostHundredths Int
  receipt                    PurchaseReceipt             @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  discrepancy                PurchaseReceiptDiscrepancy?
  invoiceMatch               PurchaseInvoiceLineMatch?

  @@index([orgId, genericItemId, receiptId])
}

// Δομημένη τιμολογιακή ασυμφωνία παραλαβής· γράφεται μία φορά μαζί με την παραλαβή.
model PurchaseReceiptDiscrepancy {
  id                 String              @id @default(cuid())
  orgId              String
  receiptId          String
  receiptLineId      String              @unique
  basis              String // AGREEMENT | PREVIOUS_PURCHASE
  kind               String // AGREEMENT_MISMATCH | PRICE_INCREASE
  expectedPriceCents Int
  actualPriceCents   Int
  reason             String
  createdAt          DateTime            @default(now())
  receipt            PurchaseReceipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  receiptLine        PurchaseReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)

  @@index([orgId, receiptId])
  @@index([orgId, kind, createdAt])
}

// Σταθερή τριπλή σύνδεση και snapshot των πραγματικών δεδομένων τιμολογίου ανά γραμμή.
model PurchaseInvoiceLineMatch {
  id             String                       @id @default(cuid())
  orgId          String
  receiptId      String
  orderLineId    String
  receiptLineId  String                       @unique
  invoiceLineId  String                       @unique
  quantityBase   Int
  unitPriceCents Int
  discountBps    Int                          @default(0)
  vatRate        Int
  createdAt      DateTime                     @default(now())
  receipt        PurchaseReceipt              @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLine      PurchaseOrderLine            @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  receiptLine    PurchaseReceiptLine          @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)
  invoiceLine    PurchaseLine                 @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  discrepancies  PurchaseInvoiceDiscrepancy[]

  @@index([orgId, receiptId])
}

model PurchaseInvoiceDiscrepancy {
  id                     String                   @id @default(cuid())
  orgId                  String
  receiptId              String
  matchId                String
  basis                  String // AGREEMENT | ORDER | RECEIPT | ACCOUNTING
  kind                   String // QUANTITY_MISMATCH | PRICE_MISMATCH | VAT_MISMATCH
  expectedQuantityBase   Int?
  actualQuantityBase     Int?
  expectedUnitPriceCents Int?
  actualUnitPriceCents   Int?
  expectedVatRate        Int?
  actualVatRate          Int?
  reason                 String
  createdAt              DateTime                 @default(now())
  receipt                PurchaseReceipt          @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  match                  PurchaseInvoiceLineMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, kind])
  @@index([orgId, receiptId])
  @@index([orgId, kind, createdAt])
}

model MrpItemSetting {
  id                  String       @id @default(cuid())
  orgId               String
  warehouseId         String?
  genericItemId       String
  supplierId          String?
  secondarySupplierId String?
  mode                String       @default("auto")
  leadDays            Int?
  coverDays           Int?
  minimumBaseQty      Int          @default(0)
  orderMultipleBase   Int          @default(1)
  shelfLifeDays       Int?
  orderDays           Int[]        @default([])
  deliveryDays        Int[]        @default([])
  updatedAt           DateTime     @updatedAt
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, warehouseId, genericItemId])
  @@index([orgId, supplierId])
}

model Rfq {
  id            String        @id @default(cuid())
  orgId         String
  number        String
  status        String        @default("OPEN")
  replyBy       DateTime
  note          String?
  createdByName String
  createdAt     DateTime      @default(now())
  org           Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lines         RfqLine[]
  suppliers     RfqSupplier[]

  @@unique([orgId, number])
}

model RfqLine {
  id                String  @id @default(cuid())
  orgId             String
  rfqId             String
  genericItemId     String
  quantityBase      Int
  unitCode          String
  awardedSupplierId String?
  rfq               Rfq     @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@unique([rfqId, genericItemId])
  @@index([orgId, genericItemId])
}

model RfqSupplier {
  id          String     @id @default(cuid())
  orgId       String
  rfqId       String
  supplierId  String
  tokenHash   String     @unique
  expiresAt   DateTime
  respondedAt DateTime?
  rfq         Rfq        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quotes      RfqQuote[]

  @@unique([rfqId, supplierId])
}

model RfqQuote {
  id                  String      @id @default(cuid())
  orgId               String
  rfqSupplierId       String
  rfqLineId           String
  packagePriceCents   Int?
  unitsPerPackage     Int?
  unitPriceHundredths Int?
  validTo             DateTime?
  note                String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  supplier            RfqSupplier @relation(fields: [rfqSupplierId], references: [id], onDelete: Cascade)

  @@unique([rfqSupplierId, rfqLineId])
  @@index([orgId, rfqLineId])
}

model DocumentDelivery {
  id            String       @id @default(cuid())
  orgId         String
  entityType    String
  entityId      String
  channel       String
  recipient     String?
  status        String
  detail        String?
  createdByName String
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, entityId, channel, recipient])
  @@index([orgId, entityType, entityId, createdAt])
}

model Machine {
  id            String               @id @default(cuid())
  orgId         String
  warehouseId   String?
  name          String
  code          String?
  capacityGrams Int?
  active        Boolean              @default(true)
  createdAt     DateTime             @default(now())
  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  maintenance   MachineMaintenance[]

  @@unique([orgId, code])
}

model MachineMaintenance {
  id            String    @id @default(cuid())
  orgId         String
  machineId     String
  kind          String
  performedAt   DateTime
  nextDueAt     DateTime?
  costCents     Int       @default(0)
  notes         String?
  createdByName String
  createdAt     DateTime  @default(now())
  machine       Machine   @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([orgId, nextDueAt])
}

model RecipeVersion {
  id            String       @id @default(cuid())
  orgId         String
  recipeId      String
  version       Int
  snapshot      Json
  createdByName String
  createdAt     DateTime     @default(now())
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, recipeId, version])
}

model ProductionPlan {
  id                     String               @id @default(cuid())
  orgId                  String
  storeId                String?
  recipeId               String
  sourceWarehouseId      String
  destinationWarehouseId String
  machineId              String?
  operatorEmployeeId     String?
  plannedFor             DateTime
  quantityGrams          Int
  status                 ProductionPlanStatus @default(PLANNED)
  batchId                String?              @unique
  note                   String?
  createdByName          String
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  org                    Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, plannedFor, status])
  @@index([orgId, sourceWarehouseId, status])
}

// Ατομικό ημερήσιο κλείσιμο: το snapshot δεσμεύει plans, αυτόματα ημιέτοιμα και τελικές παρτίδες.
model ProductionDayClose {
  id                     String       @id @default(cuid())
  orgId                  String
  warehouseId            String
  destinationWarehouseId String
  businessDate           DateTime     @db.Date
  clientKey              String
  requestHash            String
  status                 String       @default("COMPLETED")
  snapshot               Json
  createdById            String?
  createdByName          String
  closedAt               DateTime     @default(now())
  createdAt              DateTime     @default(now())
  org                    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, clientKey])
  @@unique([orgId, warehouseId, businessDate])
  @@index([orgId, businessDate, status])
}

model ProductionCorrection {
  id                     String       @id @default(cuid())
  orgId                  String
  batchId                String
  previousQuantityGrams  Int
  correctedQuantityGrams Int
  deltaGrams             Int
  reason                 String
  createdByName          String
  createdAt              DateTime     @default(now())
  org                    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, batchId, createdAt])
}

model HaccpLotCheck {
  id               String       @id @default(cuid())
  orgId            String
  lotId            String
  batchId          String?
  kind             String
  measuredValue    Float?
  unit             String?
  minimum          Float?
  maximum          Float?
  conforming       Boolean
  notes            String?
  correctiveAction String?
  checkedByName    String
  createdAt        DateTime     @default(now())
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, lotId, createdAt])
}

model PriceList {
  id        String           @id @default(cuid())
  orgId     String
  name      String
  active    Boolean          @default(true)
  validFrom DateTime         @default(now())
  validTo   DateTime?
  createdAt DateTime         @default(now())
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parties   PriceListParty[]
  items     PriceListItem[]

  @@unique([orgId, name])
}

model PriceListParty {
  orgId       String
  priceListId String
  partyId     String
  priceList   PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@id([priceListId, partyId])
  @@index([orgId, partyId])
}

model PriceListItem {
  id             String    @id @default(cuid())
  orgId          String
  priceListId    String
  genericItemId  String
  unitPriceCents Int
  vatRate        Int
  priceList      PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)

  @@unique([priceListId, genericItemId])
  @@index([orgId, genericItemId])
}

// Προσφορά χονδρικής: παγώνει πελάτη, είδη, τιμές και ΦΠΑ· η αποδοχή δεν αλλάζει όταν μετατρέπεται.
model WholesaleQuote {
  id               String               @id @default(cuid())
  orgId            String
  customerId       String
  storeId          String
  warehouseId      String
  number           String
  status           WholesaleQuoteStatus @default(DRAFT)
  validUntil       DateTime
  neededAt         DateTime?
  note             String?
  netCents         Int                  @default(0)
  vatCents         Int                  @default(0)
  totalCents       Int                  @default(0)
  customerSnapshot Json
  sentAt           DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  expiredAt        DateTime?
  convertedAt      DateTime?
  orderId          String?              @unique
  createdByName    String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  org              Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order            WholesaleOrder?      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines            WholesaleQuoteLine[]

  @@unique([orgId, number])
  @@index([orgId, customerId, status, validUntil])
  @@index([orgId, storeId, warehouseId, status])
}

model WholesaleQuoteLine {
  id             String         @id @default(cuid())
  orgId          String
  quoteId        String
  genericItemId  String
  description    String // snapshot· το έντυπο δεν εξαρτάται από μελλοντική μετονομασία του είδους
  unitLabel      String
  unitScale      Int // βασικές μονάδες ανά μονάδα εμφάνισης κατά τη δημιουργία της προσφοράς
  quantityBase   Int
  unitPriceCents Int
  vatRate        Int
  quote          WholesaleQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, genericItemId])
  @@index([orgId, genericItemId])
}

model WholesaleOrder {
  id            String               @id @default(cuid())
  orgId         String
  customerId    String
  storeId       String
  warehouseId   String
  number        String
  status        WholesaleOrderStatus @default(DRAFT)
  neededAt      DateTime?
  deliveredAt   DateTime?
  note          String?
  netCents      Int                  @default(0)
  vatCents      Int                  @default(0)
  totalCents    Int                  @default(0)
  source        String               @default("backoffice")
  externalKey   String?
  createdByName String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  org           Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  quote         WholesaleQuote?
  lines         WholesaleOrderLine[]
  documents     SalesDocument[]

  @@unique([orgId, number])
  @@unique([orgId, source, externalKey])
  @@index([orgId, customerId, status, neededAt])
}

model WholesaleOrderLine {
  id             String         @id @default(cuid())
  orgId          String
  orderId        String
  genericItemId  String
  quantityBase   Int
  unitPriceCents Int
  vatRate        Int
  order          WholesaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, genericItemId])
  @@index([orgId, genericItemId])
}

model DeliveryRoute {
  id            String         @id @default(cuid())
  orgId         String
  storeId       String?
  name          String
  plannedFor    DateTime
  driverName    String?
  status        String         @default("PLANNED")
  createdByName String
  createdAt     DateTime       @default(now())
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stops         DeliveryStop[]

  @@index([orgId, plannedFor, status])
}

model DeliveryStop {
  id            String        @id @default(cuid())
  orgId         String
  routeId       String
  orderId       String        @unique
  position      Int
  deliveredAt   DateTime?
  recipientName String?
  proofNote     String?
  route         DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, position])
  @@index([orgId, orderId])
}

model SalesDocument {
  id                 String                      @id @default(cuid())
  orgId              String
  orderId            String
  customerId         String
  storeId            String
  warehouseId        String
  seriesId           String?
  fiscalDocumentId   String?                     @unique
  docType            String
  series             String
  aa                 Int
  status             SalesDocumentStatus         @default(ISSUED)
  issuedAt           DateTime
  dueAt              DateTime?
  netCents           Int
  vatCents           Int
  totalCents         Int
  customerSnapshot   Json
  cancellationReason String?
  cancelledAt        DateTime?
  createdByName      String
  createdAt          DateTime                    @default(now())
  org                Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  order              WholesaleOrder              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  lines              SalesDocumentLine[]
  allocations        CustomerPaymentAllocation[]

  @@unique([orgId, docType, series, aa])
  @@index([orgId, customerId, status, dueAt])
  @@index([orgId, orderId, status])
  @@index([orgId, status, issuedAt]) // αναφορές και εξαγωγή λογιστή ανά περίοδο
}

model SalesDocumentLine {
  id             String        @id @default(cuid())
  orgId          String
  documentId     String
  genericItemId  String
  lotId          String?
  quantityBase   Int
  unitPriceCents Int
  vatRate        Int
  costHundredths Int           @default(0)
  document       SalesDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([orgId, genericItemId])
}

model CustomerPayment {
  id            String                      @id @default(cuid())
  orgId         String
  customerId    String
  accountId     String?
  amountCents   Int
  paidAt        DateTime
  reference     String?
  note          String?
  clientKey     String? // Nullable ώστε οι ιστορικές εισπράξεις να μην χρειάζονται backfill.
  requestHash   String?
  createdByName String
  createdAt     DateTime                    @default(now())
  org           Organization                @relation(fields: [orgId], references: [id], onDelete: Cascade)
  allocations   CustomerPaymentAllocation[]

  @@unique([orgId, clientKey])
  @@index([orgId, customerId, paidAt])
}

model CustomerPaymentAllocation {
  id          String          @id @default(cuid())
  orgId       String
  paymentId   String
  documentId  String
  amountCents Int
  createdAt   DateTime        @default(now())
  payment     CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document    SalesDocument   @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@unique([paymentId, documentId])
  @@index([orgId, documentId])
}

model B2bAccess {
  id         String       @id @default(cuid())
  orgId      String
  customerId String
  tokenHash  String       @unique
  expiresAt  DateTime?
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, customerId])
}

model Department {
  id     String       @id @default(cuid())
  orgId  String
  name   String
  kind   String       @default("other")
  active Boolean      @default(true)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

model Employee {
  id           String              @id @default(cuid())
  orgId        String
  departmentId String?
  storeId      String?
  warehouseId  String?
  userId       String?
  tillPinHash  String? // PIN ταμείου (sha256 με το id ως αλάτι)· κενό = δεν μπαίνει στο ταμείο
  name         String
  phone        String?
  email        String?
  startDate    DateTime?
  endDate      DateTime?
  active       Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pay          EmployeePay?
  shifts       Shift[]
  leaves       EmployeeLeave[]
  scheduleLink ScheduleLink?
  tillShifts   TillShift[]
  specialties  EmployeeSpecialty[] // ειδικότητες (πολλές· μία κύρια)
  stores       EmployeeStore[] // καταστήματα όπου δουλεύει· το storeId μένει ως κύριο
  invites      EmployeeInvite[]

  @@index([orgId, active, departmentId])
}

model EmployeePay {
  id                 String       @id @default(cuid())
  orgId              String
  employeeId         String       @unique
  payType            String       @default("HOURLY")
  hourlyRateCents    Int          @default(0)
  monthlySalaryCents Int          @default(0)
  iban               String?
  vatNumber          String?
  notes              String?
  updatedAt          DateTime     @updatedAt
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee           Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Shift {
  id               String       @id @default(cuid())
  orgId            String
  employeeId       String
  departmentId     String?
  storeId          String?
  productionPlanId String?
  startsAt         DateTime
  endsAt           DateTime
  breakMinutes     Int          @default(0)
  hourlyRateCents  Int?
  specialty        String? // με ποια ειδικότητα δουλεύει σε αυτή τη βάρδια (lib/specialties.ts)
  publishedAt      DateTime?
  note             String?
  createdAt        DateTime     @default(now())
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee         Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, startsAt, endsAt])
  @@index([orgId, employeeId, startsAt])
}

model SchedulePublication {
  id              String       @id @default(cuid())
  orgId           String
  storeId         String?
  groupKind       String
  fromAt          DateTime
  toAt            DateTime
  version         Int
  snapshot        Json
  publishedByName String
  publishedAt     DateTime     @default(now())
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, storeId, groupKind, fromAt, toAt, version])
}

model EmployeeLeave {
  id         String       @id @default(cuid())
  orgId      String
  employeeId String
  kind       String
  fromAt     DateTime
  toAt       DateTime
  note       String?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([orgId, employeeId, fromAt, toAt])
}

model ScheduleLink {
  id                  String       @id @default(cuid())
  orgId               String
  employeeId          String       @unique
  tokenHash           String       @unique
  active              Boolean      @default(true)
  acknowledgedVersion Int          @default(0)
  acknowledgedAt      DateTime?
  createdAt           DateTime     @default(now())
  org                 Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  employee            Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model FinanceAccount {
  id                  String                    @id @default(cuid())
  orgId               String
  storeId             String?
  name                String
  kind                String                    @default("bank")
  openingBalanceCents Int                       @default(0)
  openingAt           DateTime
  active              Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  org                 Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions        FinanceTransaction[]
  statementImports    FinanceStatementImport[]
  payrollExecutions   PayrollPaymentExecution[]

  @@unique([orgId, name])
}

model FinanceTransaction {
  id            String                @id @default(cuid())
  orgId         String
  accountId     String
  storeId       String?
  amountCents   Int
  kind          String
  referenceType String?
  referenceId   String?
  transferId    String?
  occurredAt    DateTime
  note          String?
  createdByName String
  createdAt     DateTime              @default(now())
  org           Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account       FinanceAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  statementRows FinanceStatementRow[]

  @@unique([orgId, accountId, referenceType, referenceId])
  @@index([orgId, occurredAt])
  @@index([orgId, transferId])
}

// Αποθηκευμένο snapshot statement· η αντιστοίχιση δεν συνεπάγεται νέα ledger κίνηση.
model FinanceStatementImport {
  id               String                @id @default(cuid())
  orgId            String
  accountId        String
  storeId          String?
  reviewId         String
  sourceName       String?
  fromDate         DateTime              @db.Date
  toDate           DateTime              @db.Date
  totalAmountCents Int
  matchedCount     Int
  unmatchedCount   Int
  ambiguousCount   Int
  conflictCount    Int
  createdById      String?
  createdByName    String
  createdAt        DateTime              @default(now())
  org              Organization          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  account          FinanceAccount        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  rows             FinanceStatementRow[]

  @@unique([orgId, reviewId])
  @@index([orgId, accountId, createdAt])
  @@index([orgId, storeId, createdAt])
}

model FinanceStatementRow {
  id                      String                 @id @default(cuid())
  orgId                   String
  importId                String
  line                    Int
  externalId              String?
  reference               String?
  description             String?
  bookedAt                DateTime               @db.Date
  amountCents             Int
  status                  String
  reasons                 String[]
  matchedTransactionId    String?
  candidateTransactionIds String[]
  vivaCandidates          Json?
  suggestedKind           String?
  import                  FinanceStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedTransaction      FinanceTransaction?    @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)

  @@unique([importId, line])
  @@index([orgId, matchedTransactionId])
  @@index([orgId, importId, status])
}

// Η προετοιμασία παγώνει pay/IBAN μόνο για χρήστες με finance.export + staff.pay.
model PayrollPaymentBatch {
  id               String                    @id @default(cuid())
  orgId            String
  storeId          String?
  batchId          String
  fromDate         DateTime                  @db.Date
  toDate           DateTime                  @db.Date
  status           String                    @default("PREPARED")
  totalAmountCents Int
  readyAmountCents Int
  employeeCount    Int
  readyCount       Int
  reviewCount      Int
  createdById      String?
  createdByName    String
  createdAt        DateTime                  @default(now())
  org              Organization              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  items            PayrollPaymentItem[]
  executions       PayrollPaymentExecution[]

  @@unique([orgId, batchId])
  @@index([orgId, storeId, fromDate, toDate])
  @@index([orgId, status, createdAt])
}

model PayrollPaymentItem {
  id              String              @id @default(cuid())
  orgId           String
  batchId         String
  employeeId      String
  employeeName    String
  storeId         String?
  iban            String
  amountCents     Int
  workedMinutes   Int
  reviewStatus    String
  issues          String[]
  executionStatus String              @default("NOT_EXECUTED")
  batch           PayrollPaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, employeeId])
  @@index([orgId, employeeId, executionStatus])
}

// Σε PROCESSING/UNCERTAIN απαγορεύεται νέα provider υποβολή· απαιτείται εξωτερικός συμψηφισμός.
model PayrollPaymentExecution {
  id                String              @id @default(cuid())
  orgId             String
  batchId           String
  accountId         String
  storeId           String?
  clientKey         String
  requestHash       String
  status            String              @default("PROCESSING")
  provider          String
  providerReference String?
  failureCode       String?
  confirmedAt       DateTime?
  createdById       String?
  createdByName     String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  org               Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  batch             PayrollPaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  account           FinanceAccount      @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([orgId, clientKey])
  @@index([orgId, batchId, createdAt])
  @@index([orgId, status, createdAt])
}

model Expense {
