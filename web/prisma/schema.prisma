  viewedOn DateTime     @db.Date
  views    Int          @default(0)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, storeId, viewedOn])
}

model UserPreference {
  id          String   @id @default(cuid())
  userId      String
  locale      String   @default("el")
  timezone    String   @default("Europe/Athens")
  pushEnabled Boolean  @default(false)
  alertTypes  String[] @default([])
  updatedAt   DateTime @updatedAt

  @@unique([userId])
}

// Μία ελεγχόμενη μετάβαση ανά tenant· το ιστορικό runs παραμένει ανεξάρτητα από την τρέχουσα φάση.
model MigrationCutover {
  id               String                 @id @default(cuid())
  orgId            String                 @unique
  source           String
  status           MigrationCutoverStatus @default(PREPARING)
  cursor           String?
  baselineRunId    String?                @unique
  finalRunId       String?                @unique
  adapterEvidence  Json?
  smoke            Json?
  createdById      String?
  createdByName    String
  frozenById       String?
  frozenByName     String?
  frozenAt         DateTime?
  readyAt          DateTime?
  activatedById    String?
  activatedByName  String?
  activatedAt      DateTime?
  rolledBackById   String?
  rolledBackByName String?
  rolledBackAt     DateTime?
  rollbackReason   String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  org              Organization           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  baselineRun      MigrationRun?          @relation("MigrationBaseline", fields: [baselineRunId], references: [id], onDelete: SetNull)
  finalRun         MigrationRun?          @relation("MigrationFinal", fields: [finalRunId], references: [id], onDelete: SetNull)
  runs             MigrationRun[]         @relation("MigrationCutoverRuns")

  @@index([status, updatedAt])
}

model MigrationRun {
  id             String             @id @default(cuid())
  orgId          String
  cutoverId      String?
  source         String
  kind           MigrationRunKind   @default(BASELINE)
  status         MigrationRunStatus @default(DRY_RUN)
  exportId       String?
  previousCursor String?
  sourceCursor   String?
  exportedAt     DateTime?
  bundleHash     String?
  summary        Json
  createdByName  String
  createdAt      DateTime           @default(now())
  rolledBackAt   DateTime?
  org            Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  cutover        MigrationCutover?  @relation("MigrationCutoverRuns", fields: [cutoverId], references: [id], onDelete: SetNull)
  baselineFor    MigrationCutover?  @relation("MigrationBaseline")
  finalFor       MigrationCutover?  @relation("MigrationFinal")
  records        MigrationRecord[]

  @@unique([orgId, exportId])
  @@index([orgId, createdAt])
  @@index([orgId, cutoverId, createdAt])
}

model MigrationRecord {
  id          String       @id @default(cuid())
  orgId       String
  runId       String
  entityType  String
  externalId  String
  localId     String?
  payloadHash String
  payload     Json
  status      String
  error       String?
  createdAt   DateTime     @default(now())
  run         MigrationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([orgId, entityType, externalId])
  @@index([orgId, runId, status])
}

// Εργασία που κρατά πάνω από δύο δευτερόλεπτα (πολλά αντικείμενα ή εξωτερική υπηρεσία). Η πρόοδός της γράφεται εδώ,
// ώστε το παράθυρο «Εργασίες» να τη δείχνει και μετά από αλλαγή οθόνης ή ανανέωση, από όποιο αντίγραφο του server
// κι αν ρωτήσει ο browser. Δεν αντικαθιστά τα Run/Import/Batch μοντέλα (εκείνα είναι το αποτέλεσμα)· κρατά μόνο την πορεία.
model TaskRun {
  id          String        @id @default(cuid())
  orgId       String? // null = εργασία της πλατφόρμας
  userId      String // ποιος την ξεκίνησε (σε αυτόν ανοίγει μόνο του το παράθυρο)
  userName    String
  kind        String // π.χ. "catalog.enrich" — κλειδί του registry στο lib/task-kinds.ts
  title       String // «Εμπλουτισμός κατασκευαστών»
  permission  String // το δικαίωμα που χρειάζεται όποιος τη βλέπει
  status      String        @default("RUNNING") // RUNNING | DONE | PARTIAL | FAILED
  total       Int? // null = δεν μετριέται σε βήματα (αόριστη μπάρα)
  done        Int           @default(0)
  failed      Int           @default(0)
  current     String? // «Τώρα: Α-1009»
  error       String? // ο λόγος σε απλά λόγια
  resultHref  String?
  failures    Json? // [{ id, label, reason }] όσα απέτυχαν: τα δείχνει το «Δες ποιες απέτυχαν» και τα ξανατρέχει το «Ξανά»
  seenAt      DateTime? // πότε είδε την αποτυχία όποιος την ξεκίνησε
  startedAt   DateTime      @default(now())
  heartbeatAt DateTime      @default(now())
  finishedAt  DateTime?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, startedAt])
  @@index([userId, startedAt])
  @@index([status, heartbeatAt])
}

/// Βάρδια ταμία σε ταμείο Android: ποιος δουλεύει, με πόσα μετρητά ξεκίνησε και τι μέτρησε στο κλείσιμο.
/// Ανά ταμείο υπάρχει το πολύ μία ανοιχτή (endedAt κενό)· οι πωλήσεις της βάρδιας είναι όσες έγιναν στο ταμείο μέσα στο διάστημά της.
model TillShift {
  id            String    @id @default(cuid())
  orgId         String
  deviceId      String
  employeeId    String
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  role          String? // ο ρόλος που διάλεξε στη συσκευή (κλειδί ειδικότητας)· κενό = χωρίς ειδικότητες
  openingCents  Int // μετρητά στο συρτάρι στην αρχή
  expectedCents Int? // έναρξη + μετρητά που μπήκαν − μετρητά που επιστράφηκαν, στο κλείσιμο
  countedCents  Int? // ό,τι μέτρησε ο ταμίας
  keptCents     Int? // όσα έμειναν στο συρτάρι για την επόμενη βάρδια
  reason        String? // αιτία διαφοράς
  summary       Json? // σύνοψη στο κλείσιμο (εισπράξεις, κάρτα, μετρητά, αποδείξεις, επιστροφές)
  device        Device    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([deviceId, endedAt])
  @@index([orgId, startedAt])
}

/// Κλείσιμο ημέρας ταμείου: μετά από αυτό δεν ξεκινά βάρδια με αυτή την ημερομηνία στο ταμείο.
model TillDayClose {
  id       String   @id @default(cuid())
  orgId    String
  deviceId String
  day      String // YYYY-MM-DD, ώρα Αθήνας
  closedAt DateTime @default(now())
  closedBy String // όνομα ταμία
  summary  Json
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, day])
}

// Παραγγελίες εκτός καταστήματος: τηλεφωνικές και από τις πλατφόρμες (docs/analysis/OFF-PREMISE-ORDERS.md).
enum OrderSource {
  PHONE
  WOLT
  EFOOD
}

enum OrderStatus {
  NEW // ήρθε από πλατφόρμα, περιμένει αποδοχή
  ACCEPTED // σε ετοιμασία
  READY
  OUT // στον διανομέα
  DELIVERED
  REJECTED
  CANCELLED
}

enum OrderPayment {
  DOOR_CASH // μετρητά στην πόρτα
  DOOR_CARD // κάρτα στην πόρτα
  PLATFORM // πληρώθηκε online στην πλατφόρμα
  TILL // παραλαβή: πληρώνει στο ταμείο
}

model Order {
  id            String       @id @default(cuid())
  orgId         String
  storeId       String
  source        OrderSource
  externalId    String? // ο αριθμός της πλατφόρμας
  partyId       String?
  addressId     String?
  customerName  String
  phone         String? // κανονικοποιημένο (lib/reservation.ts normalizePhone)
  address       String? // φωτογραφία της διεύθυνσης τη στιγμή της παραγγελίας
  delivery      Boolean      @default(true) // false = παραλαβή από το κατάστημα
  status        OrderStatus  @default(NEW)
  payment       OrderPayment
  totalCents    Int
  note          String?
  readyAt       DateTime? // πότε θα είναι έτοιμη (δηλώνεται στην αποδοχή)
  rejectReason  String?
  raw           Json? // ό,τι έστειλε η πλατφόρμα
  // Πληρωμή στην πόρτα ή στο ταμείο: η παραγγελία ανοίγει λογαριασμό και πληρώνεται από εκεί με τη γνωστή ροή
  billId        String?      @unique
  createdByName String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  store         Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  party         Party?       @relation(fields: [partyId], references: [id], onDelete: SetNull)
  bill          Bill?        @relation(fields: [billId], references: [id], onDelete: SetNull)
  lines         OrderLine[]
  calls         Call[]

  @@unique([orgId, source, externalId])
  @@index([orgId, storeId, status, createdAt])
  @@index([orgId, phone])
  @@index([partyId, createdAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  productId      String? // κενό = είδος της πλατφόρμας που δεν ταιριάζει με τον κατάλογο
  name           String
  quantity       Int
  unitPriceCents Int
  options        Json? // [{ name, priceCents }]
  note           String?
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum CallState {
  RINGING
  ANSWERED
  ENDED // απαντήθηκε και έκλεισε
  MISSED
}

// Εισερχόμενη κλήση από το τηλεφωνικό κέντρο (Yeastar 30011/30012): ανοίγει την καρτέλα του πελάτη στο ταμείο.
model Call {
  id         String       @id @default(cuid())
  orgId      String
  callId     String // ο αριθμός κλήσης του τηλεφωνικού κέντρου
  phone      String // κανονικοποιημένο
  extension  String?
  deviceId   String?
  partyId    String?
  orderId    String?
  state      CallState    @default(RINGING)
  seenAt     DateTime? // το ταμείο έκλεισε την καρτέλα
  startedAt  DateTime     @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  device     Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  party      Party?       @relation(fields: [partyId], references: [id], onDelete: SetNull)
  order      Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([orgId, callId])
  @@index([orgId, startedAt])
  @@index([deviceId, state, startedAt])
}

enum IntegrationKind {
  YEASTAR
  WOLT
  EFOOD
}

// Σύνδεση με εξωτερική υπηρεσία, ανά επιχείρηση. Ρυθμίζεται από την κονσόλα (Ρυθμίσεις › Συνδέσεις), όχι από .env.
model Integration {
  id            String          @id @default(cuid())
  orgId         String
  kind          IntegrationKind
  enabled       Boolean         @default(false)
  baseUrl       String? // Yeastar: η διεύθυνση του τηλεφωνικού κέντρου
  clientId      String?
  clientSecret  String? // shortcut: σε απλό κείμενο όπως τα κλειδιά myDATA· κρυπτογράφηση όταν μπει κοινό κλειδί πλατφόρμας
  webhookSecret String // υπογραφή των webhook· τη φτιάχνουμε εμείς
  lastEventAt   DateTime?
  updatedAt     DateTime        @updatedAt
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, kind])
}

// Ειδικότητα υπαλλήλου· το κλειδί και τι ανοίγει στη συσκευή ορίζονται στο lib/specialties.ts
model EmployeeSpecialty {
  employeeId String
  specialty  String
  isPrimary  Boolean  @default(false)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, specialty])
}

// Σε ποια καταστήματα του tenant δουλεύει ο υπάλληλος (βάρδιες και είσοδος στις συσκευές τους)
model EmployeeStore {
  employeeId String
  storeId    String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([employeeId, storeId])
  @@index([storeId])
}

// Link εγγραφής υπαλλήλου στο portal: token μόνο σε hash, μία χρήση, λήγει
model EmployeeInvite {
  id            String    @id @default(cuid())
  orgId         String
  employeeId    String
  tokenHash     String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdByName String
  createdAt     DateTime  @default(now())
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

// Θέση μέσα σε αποθήκη (π.χ. «Ράφι 2», «Κάδος 4»)
model StorageSpot {
  id          String     @id @default(cuid())
  orgId       String
  warehouseId String
  name        String
  active      Boolean    @default(true)
  createdAt   DateTime   @default(now())
  warehouse   Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  items       ItemSpot[]

  @@unique([warehouseId, name])
}

// Πού μπαίνει ένα υλικό σε μια αποθήκη· η παραλαβή και το απόθεμα το δείχνουν
model ItemSpot {
  genericItemId String
  warehouseId   String
  orgId         String
  spotId        String
  updatedByName String?
  updatedAt     DateTime    @updatedAt
  spot          StorageSpot @relation(fields: [spotId], references: [id], onDelete: Cascade)
  genericItem   GenericItem @relation(fields: [genericItemId], references: [id], onDelete: Cascade)

  @@id([genericItemId, warehouseId])
  @@index([spotId])
}

// Έλεγχος σκαναρισμένου παραστατικού προμηθευτή με ό,τι δήλωσε εκείνος στο myDATA (μόνο ανάγνωση, RequestDocs).
// Mockup: docs/analysis/mockups/mydata-check.html. Διαφορά χωρίς απόφαση μπλοκάρει την πληρωμή του τιμολογίου.
model MydataCheck {
  id             String       @id @default(cuid())
  orgId          String
  purchaseDocId  String       @unique
  status         String // MATCH | DIFF | NOT_FOUND | ERROR
  diff           Json? // MydataDiff[]: πεδίο, φωτογραφία, myDATA
  mydata         Json? // ό,τι βρέθηκε: mark, series, number, issuedAt, net/vat/gross
  error          String?
  checkedAt      DateTime
  recheckUntil   DateTime? // NOT_FOUND/ERROR: ξαναελέγχεται κάθε βράδυ ως τότε
  resolution     String? // AADE (κρατήθηκαν τα στοιχεία της ΑΑΔΕ) | PAPER (το χαρτί είναι σωστό)
  resolvedByName String?
  resolvedAt     DateTime?
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseDoc    PurchaseDoc  @relation(fields: [purchaseDocId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

/// Παραστατικό προμηθευτή που βρέθηκε στο myDATA (RequestDocs) και ταιριάζει ή όχι με τις αγορές μας (lib/mydata-incoming.ts).
/// MISSING: δεν το έχουμε· MATCHED: βρέθηκε σε αγορά· IMPORTED: πέρασε από το myDATA· IGNORED: δεν μας αφορά.
model MydataIncoming {
  id             String       @id @default(cuid())
  orgId          String
  mark           String
  supplierVat    String
  supplierName   String
  type           String? // invoiceType: 1.1, 5.1 …
  series         String?
  number         String?
  issuedAt       DateTime?
  netCents       Int?
  vatCents       Int?
  grossCents     Int?
  doc            Json // MyIncomeDoc με τις γραμμές: από αυτό φτιάχνεται το πρόχειρο στο «Πέρασέ το»
  status         String       @default("MISSING")
  purchaseDocId  String?      @unique
  ignoredReason  String?
  resolvedByName String?
  resolvedAt     DateTime?
  notifiedAt     DateTime? // πότε μπήκε στις «Εργασίες» ως παλιό (μία φορά)
  firstSeenAt    DateTime     @default(now())
  checkedAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  purchaseDoc    PurchaseDoc? @relation(fields: [purchaseDocId], references: [id], onDelete: SetNull)

  @@unique([orgId, mark])
  @@index([orgId, status])
}

// Αποδείξεις ταμείου απέναντι στα σύνολα της ΑΑΔΕ (RequestMyIncome): μία γραμμή ανά εκδότη, ημέρα και τύπο (lib/mydata-receipts.ts).
// Η ΑΑΔΕ δίνει μόνο πλήθος και σύνολο ανά ημέρα· οι αποδείξεις του τερματικού διαβιβάζονται από τη Viva.
model MydataDayCheck {
  id          String       @id @default(cuid())
  orgId       String
  issuerVat   String
  issuerName  String
  day         DateTime     @db.Date // ημερομηνία έκδοσης (ώρα Ελλάδας)
  invType     String // 11.1, 11.4 …
  oursCount   Int
  oursCents   Int
  aadeCount   Int? // κενό = δεν ελέγχθηκε ακόμα
  aadeCents   Int?
  status      String // MATCH | DIFF
  gaps        Json? // Gap[] (lib/mydata-receipts-match.ts): οι αποδείξεις της ημέρας που δεν ταιριάζουν με την ΑΑΔΕ
  firstDiffAt DateTime? // από πότε διαφέρει
  notifiedAt  DateTime?
  checkedAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, issuerVat, day, invType])
  @@index([orgId, status])
}
